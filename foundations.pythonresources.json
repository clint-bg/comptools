n":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bNATf1RwO5"},{"type":"inlineCode","value":"birthday","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bPBgGnPT4f"},{"type":"text","value":" and ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Un5ZJyDDCK"},{"type":"inlineCode","value":"greet","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"odh3mWyiY4"},{"type":"text","value":".  Here is an example:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q4Q1635FUW"}],"key":"jrXdCUJ47F"}],"key":"bK4apGqxXp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class person():\n    def __init__(self,name,age): #the __init__ method is called when the class is instantiated\n        self.name = name #self refers to the instance of the class\n        self.age = age","key":"KDhj6gDlUa"},{"type":"outputs","id":"iMnLDT9msfsPdYFFhhQay","children":[],"key":"K72mJ3vATk"}],"key":"MnRoJKamWD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"joe = person('Joe Bai',25) #create an object (an instance)  of the person class\nprint(f'Hello, my name is {joe.name} and I\\'m {joe.age}.') #access the name attribute of the joe object","key":"CF38d7AvLf"},{"type":"outputs","id":"1V9k_vgs2-JInERFYev2H","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Hello, my name is Joe Bai and I'm 25.\n"},"children":[],"key":"BZHqyw8x9u"}],"key":"jj0TuJgoke"}],"key":"qeDvO1nmIj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"I recommend using the ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bM64We9wYb"},{"type":"link","url":"https://param.holoviz.org/index.html","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"param","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MxCRaW5F5Q"}],"urlSource":"https://param.holoviz.org/index.html","key":"d9rJuqFhZ0"},{"type":"text","value":" package to define objects.  It’s has many benefits.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ecOShFbz1X"}],"key":"ac0aF67ypC"}],"key":"M5gN1uXLFB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import param\nclass gas(param.Parameterized):\n    Mw = param.Number(0.02897, bounds=(0,None), doc='Molecular weight of the gas, kg/mol')\n    Rg = param.Number(8.314, bounds=(0,None), doc='Gas constant, J/mol/K',constant=True)\n    T = param.Number(300, bounds=(0,None), doc='Temperature of the gas, K')\n    P = param.Number(101325, bounds=(0,None), doc='Pressure of the gas, Pa')\n    def density(self):\n        return self.Mw*self.P/(self.Rg*self.T) #density in kg/m^3\n\nair = gas(Mw=28.97,T=300)\nprint(f'The density of air at {air.T} K and {air.P} Pa is {air.density():0.2f} kg/m^3')","key":"gnTVlk4RNq"},{"type":"outputs","id":"XR2DEoK8zvg2rXW8YzyDW","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The density of air at 300 K and 101325 Pa is 1176.88 kg/m^3\n"},"children":[],"key":"saXC0alB9H"}],"key":"ojNKkbIsG8"}],"key":"mnNltFrRWP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Here's a benefit of the param library, I can get the doc's on each parameter\nprint(air.param.Mw.doc)\nhelp(air.param.Mw)","key":"owW3Prog7F"},{"type":"outputs","id":"iTNCtGHt3w_epYG8HN6UI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Molecular weight of the gas, kg/mol\nHelp on Number in module param:\n\n    Molecular weight of the gas, kg/mol\n\n"},"children":[],"key":"IuJ62SJxmS"}],"key":"ecnrayvpTG"}],"key":"y8wvUz80ko"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Bits","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kFzKfxFtt4"}],"identifier":"bits","label":"Bits","html_id":"bits","implicit":true,"key":"mCBDwAJ08W"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Bits are collections of 1s and 0s (or on versus off in a transistor).  They are the basis of all computer operations.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"dnX6SbN5A1"}],"key":"yGytQi5zbz"}],"key":"iatSVFMW5d"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# '101' is \nprint(f'001 is 2^2*1 + 2^1*0 + 2^0*1 = {2**2*1 + 2**1*0 + 2**0*1}')\n#or\nprint(int('101',2))","key":"qLvH29O1Oh"},{"type":"outputs","id":"sjZBfdm2f4xSYriVSmkBm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"001 is 2^2*1 + 2^1*0 + 2^0*1 = 5\n5\n"},"children":[],"key":"PtESUDasdO"}],"key":"spXAeo1quU"}],"key":"l7Jd6lF9uT"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Below is a code snippet to calculate the number of bits required to represent a number.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LDYo9VwfuF"}],"key":"BCvju763Ad"}],"key":"dIdDDrjmQu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# This calculates the number of bits a variable holds\ndef bits(n):\n    return len(bin(n))-2 #bin(n) returns the binary representation of n as a string\nprint(bits(255))","key":"xA9e4L28vN"},{"type":"outputs","id":"QSOB1MaVbcmxclACDATm_","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"8\n"},"children":[],"key":"ZepjtOBjPZ"}],"key":"XcCvk28tf8"}],"key":"wBSlwNVTGJ"}],"key":"pVoRlgM2HA"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Pre-course Preparation","url":"/foundations/preclassprep","group":"Computational Tools for Chemical Engineers"},"next":{"title":"Excel Resources","url":"/foundations/excelresources","group":"Computational Tools for Chemical Engineers"}}},"domain":"http://pre.render"}
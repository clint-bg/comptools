"key":"JRlHGhraPI"}],"key":"qH9gAaUgdt"},{"type":"heading","depth":2,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Syllabus","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"RvjG8bBidR"}],"identifier":"syllabus","label":"Syllabus","html_id":"syllabus","implicit":true,"key":"QdNimHhKOG"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"The syllabus is available on Canvas.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"lnNAn1zBBI"}],"key":"NIDSBNs4wY"},{"type":"heading","depth":2,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Learning Outcomes","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"BWiKss1w4H"}],"identifier":"learning-outcomes","label":"Learning Outcomes","html_id":"learning-outcomes","implicit":true,"key":"gUzr6jBEYA"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Learning Outcomes. Students will be able to:","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"bhLKbSs0eK"}],"key":"JgQd1c0Bx5"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":13,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"perform unit conversions;","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"G4d2ezk3vj"}],"key":"UOvZVN6kdb"}],"key":"OmloQRulr4"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"ensure dimensional consistency when evaluating equations;","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"qodzOdFXb7"}],"key":"er4l9yhAzs"}],"key":"merjxOfAb5"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"use a spreadsheet program to perform engineering calculations;","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"NKGuzHAfG8"}],"key":"IrHNOilojF"}],"key":"AgNtHKJoJt"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"solve numerical and symbolic problems using computer tools (e.g. curve fitting, integration, solving equations etc.);","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"klOVm3GqNJ"}],"key":"QWm859IZps"}],"key":"hk300q36Cx"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"write program structures (e.g. loops, arrays, conditionals, functions) and understand when programming is most appropriate;","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"SR2KXPyUFM"}],"key":"ztv8TnC5hT"}],"key":"zXe1IlRbQL"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"convert problem solving strategies to procedural algorithms;","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"hwJTDwo6pP"}],"key":"voWeSzQqBG"}],"key":"xCnUtAXzyA"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"make order of magnitude estimates, assess reasonableness of solutions, and select appropriate levels of solution sophistication.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"xFLPMygyUR"}],"key":"obYAWkHKsE"}],"key":"Nh05mTDIA0"}],"key":"nArzwaVm3v"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Course Approach","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"JUqsaa2VlD"}],"identifier":"course-approach","label":"Course Approach","html_id":"course-approach","implicit":true,"key":"Y6Q0koD1in"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"I’ll explain with a parable: Instead of teaching you about all the details of a hammer, I hope to work with you to build a shelf, a table, and some walls together. During building of the shelf, and table, and walls, you’ll learn to use a hammer as well as other tools.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"tUEHIpnko4"}],"key":"BhkctRw7Hy"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Similarly, I prefer not to take time to highlight in-depth details of the tools we’ll use. Instead, we’ll use those tools to work multiple problems.  You’ll learn the details of the tools as you use them in this class and throughout your education and career.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"DY1Qf1Xohy"}],"key":"SwtQfxHJVd"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"This approach is called ","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"qVUeRx4iE4"},{"type":"link","url":"https://en.wikipedia.org/wiki/Just-in-time_teaching","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Just-in-Time Teaching","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"urxpKHorlk"}],"urlSource":"https://en.wikipedia.org/wiki/Just-in-time_teaching","data":{"page":"Just-in-time_teaching","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"RqZ3nBGByS"},{"type":"text","value":".  It is a form of active learning.  It is similar to how the course has been taught in the past with some minor changes. This approach replicates how a trade can be learned as an apprentice.  You’ll learn by doing I hope.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"utw0tHs5kF"}],"key":"DPDNpDOH0p"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Please remember to be patient. You won’t master these skills you’re being introduced to in a single semester.  You’ll need to practice them throughout your education and career. I hope the class gives you practice and some examples you can refer to and at the same time cause some excitement for using the tools in the future.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"Uxz3hiKNIZ"}],"key":"gyM8xEhtqE"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"Lectures and modules will review specific examples (some with classroom demonstrations) and the homework will reinforce those examples and introduce specific computation concepts and tools. Those tools will be used to solve the problem and be reinforced in the class discussions and homework.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"dSomj9LMEA"}],"key":"v3jsBtu7vE"},{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"You are at a time when more information is readily at your fingertips than any other time in history. When you have a question, you can find the answer. I expect you to use the resources available to you while adhering to ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"dxbIueIVJP"},{"type":"link","url":"https://policy.byu.edu/view/academic-honesty-policy","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"BYU’s honesty policy","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"cEt1PDTaX0"}],"urlSource":"https://policy.byu.edu/view/academic-honesty-policy","key":"PNyWd4E9ut"},{"type":"text","value":".","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"bnj1wXPzAc"}],"key":"KP755GDEnE"},{"type":"block","children":[{"type":"list","children":[{"type":"listItem","children":[{"type":"link","url":"/","internal":true,"children":[{"type":"text","value":"Computational Tools for Chemical Engineers","key":"I3NcRDJifl"}],"urlSource":"/","key":"QUqUVJlHpU"}],"key":"Hjhs4m4WAp"},{"type":"listItem","children":[{"type":"link","url":"/foundations","internal":true,"children":[{"type":"text","value":"Foundations","key":"qDrlLwFLh7"}],"urlSource":"/foundations","key":"z7cJb0vfrB"},{"type":"list","children":[{"type":"listItem","children":[{"type":"link","url":"/comptools/_public/preclassprep-1e56029abbe1a1845f6c572cbe41fe77.ipynb","internal":true,"children":[{"type":"text","value":"Pre-course Preparation","key":"GxOfRXJk7r"}],"urlSource":"/foundations/preclassprep","static":true,"protocol":"file","key":"TvoDvZHBCh"}],"key":"UmboYaZxG9"},{"type":"listItem","children":[{"type":"link","url":"/foundations/pythonresources","internal":true,"children":[{"type":"text","value":"Python Resources","key":"S369tzyZca"}],"urlSource":"/foundations/pythonresources","dataUrl":"/foundations.pythonresources.json","protocol":"file","key":"idfjqscWbr"}],"key":"W4viy2wBuR"},{"type":"listItem","chi
{"version":3,"kind":"Notebook","sha256":"b25f25b4b0a4d4663801e0b292f4ca4831e90a818b573cb92503988f48abf783","slug":"casestudies.thermo","location":"/casestudies/thermo.ipynb","dependencies":[],"frontmatter":{"title":"Thermodynamics","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3"},"authors":[{"nameParsed":{"literal":"Clint Guymon","given":"Clint","family":"Guymon"},"name":"Clint Guymon","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Brigham Young University","given":"Brigham Young","family":"University"},"name":"Brigham Young University","id":"contributors-myst-generated-uid-1"}],"github":"https://github.com/clint-bg/comptools","numbering":{"title":{"offset":1}},"source_url":"https://github.com/clint-bg/comptools/blob/main/casestudies/thermo.ipynb","edit_url":"https://github.com/clint-bg/comptools/edit/main/casestudies/thermo.ipynb","thumbnail":"/comptools/_public/f55dd6c71e9f9add6335314d0fefc46d.jpeg","exports":[{"format":"ipynb","filename":"thermo.ipynb","url":"/comptools/_public/thermo-1a86905507dd489af4f361a8e8d84474.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"You’ll measure and model the behavior of the temperature and mass (using a scale) of a venting canned air duster. Below are the equations you’ll need to solve to estimate the temperature as a function of time and the mass loss as a function of time. You’ll then compare your model to the data you collect by tying a rubber band around the trigger and measuring the temperature and mass loss as a function of time with the temperature probe and scale.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"BvrBG1PcLl"}],"key":"qTUd00kgEQ"}],"key":"imUwaAB9Wm"},{"type":"block","kind":"notebook-content","data":{"id":"PmVBrJP0qSky"},"children":[{"type":"image","url":"/comptools/_public/f55dd6c71e9f9add6335314d0fefc46d.jpeg","alt":"CleanDr.jpg","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eWSiDbFi9T","urlSource":"data:image/jpeg;base64,/9j/4AAQSk...8AgH//2Q=="}],"key":"n08c2cWOvL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Task 1: Review the below code","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RtuvOp8hOv"}],"identifier":"task-1-review-the-below-code","label":"Task 1: Review the below code","html_id":"task-1-review-the-below-code","implicit":true,"key":"qMgNdiBUdL"}],"key":"Nqi6E4w8DA"},{"type":"block","kind":"notebook-content","data":{"id":"O_s1-h99p1z5"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"First define model parameters","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jCBecK2vWz"}],"identifier":"first-define-model-parameters","label":"First define model parameters","html_id":"first-define-model-parameters","implicit":true,"key":"zP9D9DQIWd"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Found online by searching for property data for difluoroethane plus the parameters of the can. Estimated the heat and mass transfer coefficients.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"c81QUA2wCP"}],"key":"AMPYXC5C6g"}],"key":"OZsd3bU7Qt"},{"type":"block","kind":"notebook-code","data":{"id":"gPctOEAehV_l"},"children":[{"type":"code","lang":"python","executable":true,"value":"#import needed packages\nimport numpy as np\nfrom tqdm import tqdm\nimport matplotlib.pyplot as plt  \nimport pandas as pd","key":"EyIgiETVw0"},{"type":"outputs","id":"ve1-3YDXj9Pvbi4HLZwmL","children":[],"key":"LbR793CFkF"}],"key":"IhW2AchgkR"},{"type":"block","kind":"notebook-code","data":{"id":"icCbRG-hIv8i"},"children":[{"type":"code","lang":"python","executable":true,"value":"#model parameters for the venting of difluoroethane from a compressed container (all SI units)\nlcan = 0.15 #150mm tall canister\ndcan = 0.065 #diameter of can\nharea = np.pi*lcan*dcan #150mm tall canister 65 mm diameter\nmarea = np.pi/4*dcan**2\nTsurr = 295 #surrounding temperature, K\nTref = 273 #reference temperature, K\nfactor = 0.9 #vent factor\ngasConstant = 8.314 #J/mol/K\ndownstreamPressure = 12.2/14.5*1e5 #Pa, atmospheric pressure at test elevation approximately\ngamma = 1.14 #ratio of specific heats of the gas\nmolecularWeight = 0.06605 #kg/mol\ndensity = 2700 #kg/m3\nCvVap = 59.58/gamma #J/mol/K, constant volume heat capacity\norigmass = 10*0.0283495 #kg, amount initially present in the canister\nVol = lcan*np.pi/4*dcan**2#volume of the canister\n#tuneable parameters\narea = np.pi/4*0.0015**2 #orifice area for escaping gas,m2","key":"wLihSWGMbX"},{"type":"outputs","id":"OM0LEGzAbGO7sfnpUKz6s","children":[],"key":"ALnVQJ8rvw"}],"key":"BNLOBTkC0m"},{"type":"block","kind":"notebook-code","data":{"colab":{"base_uri":"https://localhost:8080/"},"id":"BbsqC1UagJKj","outputId":"861923da-268c-4d60-f7e0-0843c5ec65d9"},"children":[{"type":"code","lang":"python","executable":true,"value":"origmass","key":"PuHioV7xds"},{"type":"outputs","id":"MXjtTYa90VsbkphWxC1T6","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":14,"metadata":{},"data":{"text/plain":{"content":"0.283495","content_type":"text/plain"}}},"children":[],"key":"uTz0j5uvrM"}],"key":"vFeTIlyjnM"}],"key":"RQ7HcvWTyc"},{"type":"block","kind":"notebook-content","data":{"id":"AzmO80RCs-5J"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now specify the functions needed:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G30hQ0pBLD"}],"identifier":"now-specify-the-functions-needed","label":"Now specify the functions needed:","html_id":"now-specify-the-functions-needed","implicit":true,"key":"XXFCFgQzYx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Venting through an orifice (mach number needed),","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Y8XYRze4Sv"}],"key":"uTjHHHUqao"}],"key":"meXpHDM27v"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Saturated vapor pressure,","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OqxgP0oZpo"}],"key":"LdrjIp3fBb"}],"key":"y0H5Vfz5uW"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Equation of State,","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"AOay06SVkA"}],"key":"GQafFIlwKf"}],"key":"Nh4LIVxGzG"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Derivatives of moles and temperature (based on energy and mole balances)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"VRX5ckbGI0"}],"key":"uMDPUtlTFh"}],"key":"ArdrIDsSPI"}],"key":"v8eAL8z15h"}],"key":"G0iT9IGE1v"},{"type":"block","kind":"notebook-code","data":{"id":"mfuC-v7CQaKk"},"children":[{"type":"code","lang":"python","executable":true,"value":"#specify mach number function\ndef mach(upstreamPressure):\n  tau = 500\n  transition = np.tanh((upstreamPressure-downstreamPressure)/tau)/2+0.5\n  ratio = transition*upstreamPressure/downstreamPressure + (1-transition)*downstreamPressure/upstreamPressure\n  multiplier = 1*transition-1*(1-transition)\n  mach_abs=np.sqrt(2/(gamma-1)*(ratio**((gamma-1)/gamma)-1))\n  return min(1.,mach_abs)*multiplier\n\ndef dndtvent(pressure,temperature): #rate of change of moles from a pressurized scenario\n  #calculate the mach number\n  machno = mach(pressure)\n  if downstreamPressure>pressure:\n    drivingPressure = downstreamPressure\n  else:\n    drivingPressure = pressure\n  dndt = drivingPressure*area*factor*np.sqrt(gamma/(gasConstant*temperature*molecularWeight))*machno*(1+(gamma-1)/2*machno**2)**((gamma+1)/(2-2*gamma))\n  return dndt\n\ndef psat(temperature): #saturated vapor pressure using Antione's equation\n  constants = [4.23406,896.171,-34.714]\n  return (10**(constants[0]-(constants[1]/(temperature+constants[2]))))*1e5\n  \ndef pressure(molesLiq,molesVap,tempVap): #gas pressure from eos, assumed ideal\n  return molesVap*gasConstant*tempVap/(Vol-molesLiq*molecularWeight/density) ","key":"k0UEkhlDg5"},{"type":"outputs","id":"eUapQCRh5kyZaXWSKB93R","children":[],"key":"yY1PyEkH68"}],"key":"qXSioRNoUR"},{"type":"block","kind":"notebook-content","data":{"id":"Eg1I4eLrJcHL"},"children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Include in the model the two phases with heat transfer","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CpGSjdM9E4"}],"identifier":"include-in-the-model-the-two-phases-with-heat-transfer","label":"Include in the model the two phases with heat transfer","html_id":"include-in-the-model-the-two-phases-with-heat-transfer","implicit":true,"key":"oGxc8rMrAo"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Additional parameters","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"uH2egrRKe6"}],"key":"GBjQgZB0iz"}],"key":"AXE3nlWTYh"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Heat transfer","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"o1Cue3Oz6Q"}],"key":"HIgIVSuDQB"}],"key":"WatfQYVSkS"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Psat and mass transfer functions","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"a13OLPTkyc"}],"key":"SbYK17MQt0"}],"key":"EvSTcxShs8"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Derivatives of the moles and temperature are evaluated for each phase","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jgDZz7nQXY"}],"key":"yz5KurJ2Lz"}],"key":"xAOjXWSMq6"}],"key":"kloz6leFNu"}],"key":"vAqKDsa6ax"},{"type":"block","kind":"notebook-code","data":{"id":"sVTWitsLXF7M"},"children":[{"type":"code","lang":"python","executable":true,"value":"hvap = 22000 #heat of vaporation, J/mol\nCvLiq = 118.4 #Cp,J/mol/K, assuming the constant volume heat capcity is very close to this\n#tuneable parameters\nhcv = 40 #convective heat transfer coefficient, J/m2/K\nkm = 0.05 #mass transfer coefficient, m/s","key":"NrvidsiuBT"},{"type":"outputs","id":"ScOP5Ut_l-yP_27-jeiyQ","children":[],"key":"a0B1HLrnhw"}],"key":"IIr9WZgmfW"},{"type":"block","kind":"notebook-code","data":{"id":"kLsTRCk5WlUo"},"children":[{"type":"code","lang":"python","executable":true,"value":"#include heat transfer\ndef heatIn(temperature): #heat into the volume\n  return harea/2*hcv*(Tsurr-temperature) #1/2 factor for half the area for each of liq or vap\n\n#include mass transfer between the liquid and the gas\ndef noutLiq(molesLiq,molesVap,tempLiq,tempVap): #mass transfer from the liquid surface\n  return km*marea*(psat(tempLiq)/(gasConstant*tempLiq)-pressure(molesLiq,molesVap,tempVap)/(gasConstant*tempVap))","key":"JQMrQdLRUr"},{"type":"outputs","id":"n5Vrzyc9un8dmv53QRocJ","children":[],"key":"T8KdJbdnqs"}],"key":"gZqsJHpRFQ"},{"type":"block","kind":"notebook-code","data":{"id":"7cKD3ty8KvNb"},"children":[{"type":"code","lang":"python","executable":true,"value":"def derivatives(molesLiq,molesVap,tempLiq,tempVap):\n  noutL = noutLiq(molesLiq,molesVap,tempLiq,tempVap); noutV = dndtvent(pressure(molesLiq,molesVap,tempVap),tempVap)\n  dndtLiq = -noutL\n  dndtVap = noutL-noutV\n  dTdtLiq = (heatIn(tempLiq)-noutL*hvap+noutL*CvLiq*(tempLiq-Tref))/(molesLiq*CvLiq)\n  dTdtVap = ((noutV-noutL)*CvVap*(tempVap-Tref)+noutL*CvVap*gamma*(tempLiq-Tref)-noutV*CvVap*gamma*(tempVap-Tref)+heatIn(tempVap))/(molesVap*CvVap)\n  return [dndtLiq,dndtVap,dTdtLiq,dTdtVap]","key":"zHfBvjMcNA"},{"type":"outputs","id":"6b-QjBL2HkxPAs1VpiH2y","children":[],"key":"Wn8CtVKIS5"}],"key":"lP0KumNT8S"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Task 2: Complete the simulation with the above functions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vGljpNlqy6"}],"identifier":"task-2-complete-the-simulation-with-the-above-functions","label":"Task 2: Complete the simulation with the above functions","html_id":"task-2-complete-the-simulation-with-the-above-functions","implicit":true,"key":"Z4i1VlgGFR"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"You’ll obtain the simulated temperature and mass of the liquid in the can as a function of time. You’ll add an integration step to obtain the variables from their derivatives.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ysm9WlnwaN"}],"key":"UI9l5vuCc1"}],"key":"E4Mv6lP8dC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Task 3: Obtain Experimental Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NGf9LJ2ssE"}],"identifier":"task-3-obtain-experimental-data","label":"Task 3: Obtain Experimental Data","html_id":"task-3-obtain-experimental-data","implicit":true,"key":"ISwwMg4cXJ"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Use the ESP32 and K-type Thermocouple to measure the temperature as the difluoroethane vents.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ywL3BABjHO"}],"key":"oI2yLNpg8f"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"You can review the safety of such a procedure by reviewing this document: ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"iQBwMV8wCB"},{"type":"link","url":"https://github.com/clint-bg/demos/blob/main/ventingVapor/difluoroethane_concentration.ipynb","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Safety calculations","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"sMSUTu189g"}],"urlSource":"https://github.com/clint-bg/demos/blob/main/ventingVapor/difluoroethane_concentration.ipynb","data":{"kind":"file","org":"clint-bg","repo":"de
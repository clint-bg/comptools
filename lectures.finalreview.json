{"version":3,"kind":"Notebook","sha256":"c216f64c7b94072cbf4a97b909b789d48e103f22f35204337c90726adb96d434","slug":"lectures.finalreview","location":"/lectures/27-FinalReview.ipynb","dependencies":[],"frontmatter":{"title":"27 - Final Exam Review","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Clint Guymon","given":"Clint","family":"Guymon"},"name":"Clint Guymon","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Brigham Young University","given":"Brigham Young","family":"University"},"name":"Brigham Young University","id":"contributors-myst-generated-uid-1"}],"github":"https://github.com/clint-bg/comptools","numbering":{"title":{"offset":1}},"source_url":"https://github.com/clint-bg/comptools/blob/main/lectures/27-FinalReview.ipynb","edit_url":"https://github.com/clint-bg/comptools/edit/main/lectures/27-FinalReview.ipynb","exports":[{"format":"ipynb","filename":"27-FinalReview.ipynb","url":"/comptools/_public/27-FinalReview-b48a3e4293d3e5d2e8dc22a6280a15b3.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.integrate import odeint","key":"ZRj4p6dilI"},{"type":"outputs","id":"LxVKzYo_7jZUdD9nF1oe1","children":[],"key":"Htpkfd63On"}],"key":"r4tBFEPzfl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Python Basics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wwSm1uUsyL"}],"identifier":"python-basics","label":"Python Basics","html_id":"python-basics","implicit":true,"key":"H46StztTuu"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Be familiar with the different variable types and understand how to use them. See the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"RgnMIFucaJ"},{"type":"link","url":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Python Foundations page.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NrNzZe0uwx"}],"urlSource":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","key":"vMeiOI1DrM"}],"key":"W4FxbP23Fe"}],"key":"XiDkO0sCsy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Functions and Objects","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"di6Clvb4HA"}],"identifier":"functions-and-objects","label":"Functions and Objects","html_id":"functions-and-objects","implicit":true,"key":"fCVMOpHCQq"}],"key":"mjvYA26fAA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you sum every third number from 1007 to 2023 using python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vGwy0hXetu"}],"key":"yNBvcZPHwK"}],"key":"S5Zhk4Mo34"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solving Equations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qbWdzBgGzW"}],"identifier":"solving-equations","label":"Solving Equations","html_id":"solving-equations","implicit":true,"key":"l98uXBo7FT"}],"key":"d9l25mjqSV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you solve multiple coupled, non-linear equations in python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"S9DrFM2O0y"}],"key":"NQvXGlIGB6"}],"key":"JTaO8nhlPj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ODEInt Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ejbT9kHgYW"}],"identifier":"odeint-review","label":"ODEInt Review","html_id":"odeint-review","implicit":true,"key":"PEpZknbyda"}],"key":"P4c9LitqpV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example of using ODEInt to solve a system of ODEs with SEIRD model (S: susceptible, E: exposed, I: infected, R: recovered, D: dead). The SEIRD model approximates the number of people infected with a contagious illness in a population. The model is expressed as a system of differential equations and is solved numerically.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oSKBqIsWrV"}],"key":"IROHLUy45Q"}],"key":"c6MJLHXLkh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def deriv(y, t, N, beta, gamma, delta, rho):\n    S, E, I, R, D = y\n    dSdt = -beta * S * I / N\n    dEdt = beta * S * I / N - delta * E\n    dIdt = delta * E - gamma * I - rho * I\n    dRdt = gamma * I\n    dDdt = rho * I\n    return dSdt, dEdt, dIdt, dRdt, dDdt","key":"oQqXGHDsBk"},{"type":"outputs","id":"3C7TuZiVCIQDyTKpkpfce","children":[],"key":"GA6xVMFOBL"}],"key":"tSR5q1wkFf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#initial values\nN = 1000000\nD = 14.0\ngamma = 1.0 / D\ndelta = 1.0 / 5.0\nrho = 0.01\nbeta = 2.5 * gamma\nS0, E0, I0, R0, D0 = N-1, 1, 0, 0, 0\ny = S0, E0, I0, R0, D0","key":"eXH9K64sHe"},{"type":"outputs","id":"77vukSvGgOzmxqOwhQWJA","children":[],"key":"vlNat51mxf"}],"key":"ZlmHhSeWCU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# solution\nt = np.linspace(0, 365, 365)\nsol = odeint(deriv, y, t, args=(N, beta, gamma, delta, rho))","key":"BEqZoLlSFP"},{"type":"outputs","id":"hm4KshhLQISTLTCwn7IQ8","children":[],"key":"offqPxDg3V"}],"key":"e4ufGcF68l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.shape","key":"lp6vLdnsld"},{"type":"outputs","id":"eXEn9Qeenim2bVhjApDYo","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":35,"metadata":{},"data":{"text/plain":{"content":"(365, 5)","content_type":"text/plain"}}},"children":[],"key":"gemCOOSzSy"}],"key":"wRlJRsGLIj"}],"key":"yaII9Fp3NM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.T.shape","key":"m26HuzoYTd"},{"type":"outputs","id":"JwbpCBlTuvHqy7P57qRtM","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":34,"metadata":{},"data":{"text/plain":{"content":"(5, 365)","content_type":"text/plain"}}},"children":[],"key":"J6L3acZkNa"}],"key":"YuMMdtkHVZ"}],"key":"XpcJu57jAj"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We’ll transpose the solution with the .T operator so that we can plot the solution for each variable as a function of time.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ravpWw5WE9"}],"key":"A3Uq5orOdU"}],"key":"af1pgDm6Zr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#plot results\nS, E, I, R, D = sol.T\nfig = plt.figure(facecolor='w')\nax = fig.add_subplot(111, axisbelow=True)\nax.plot(t, S/1000, 'b', alpha=0.5, lw=2, label='Susceptible')\nax.plot(t, E/1000, 'y', alpha=0.5, lw=2, label='Exposed')\nax.plot(t, I/1000, 'r', alpha=0.5, lw=2, label='Infected')\nax.plot(t, R/1000, 'g', alpha=0.5, lw=2, label='Recovered with immunity')\nax.plot(t, D/1000, 'k', alpha=0.5, lw=2, label='Dead')\nax.set_xlabel('Time /days')\nax.set_ylabel('Number (1000s)')\nax.set_ylim(0,1200)\nax.set_xlim(0,365)\n#ax.grid(b=True, which='major', c='w', lw=2, ls='-')\nlegend = ax.legend()\nlegend.get_frame().set_alpha(0.5)\nplt.show()","key":"SKRhJykcDk"},{"type":"outputs","id":"Nfhe-gcCZc5mPA_BgeTSw","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ea6e04932ae561f3922057d93a013b2","path":"/comptools/_public/4ea6e04932ae561f3922057d93a013b2.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"uZBZ2n9hFl"}],"key":"p5Nqb8MQeX"}],"key":"CpwK4BG1Hw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Doing the same integration of the SEIRD model in Excel using Euler’s method is given here: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m29iUNYoFF"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/inclasseulerdisease​.xlsx","key":"asr2trQcAO"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/inclasseulerdisease.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/inclasseulerdisease.xlsx"},"internal":false,"protocol":"github","key":"qrsJdz3NJW"}],"key":"uQAXaFvh8U"}],"key":"PqAJyyh7JV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Regression Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SZZkbXxc2B"}],"identifier":"regression-review","label":"Regression Review","html_id":"regression-review","implicit":true,"key":"CfoVXgeR0o"}],"key":"KLjqUxpi0D"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Different methods of regression include:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y5THJMiDGB"}],"key":"V56IKsFPt8"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear Regression","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"r86F6whD1v"}],"key":"NCBDjqcqUH"}],"key":"GS4b1VBZ37"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Polynomial Regression","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bZDvLttHgJ"}],"key":"bGpcYn6oaA"}],"key":"sSlshvoJ5e"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Custom relationship using curve_fit or least_squares or minimize","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"EiNtGUEcbd"}],"key":"NEdpzGhvMe"}],"key":"Mhbzp9Ndyx"}],"key":"koI4ay4Szn"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Examples could include:","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"rJSQCbCqX8"}],"key":"nzbm5pCjs9"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a line to a set of data","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"eOsbjadhpQ"}],"key":"Q58BbGXCnC"}],"key":"ASNat1tPMF"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a polynomial to a set of data","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"V1jiEItlv8"}],"key":"klQF0w23dZ"}],"key":"tjT2BaVATz"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a custom relationship to a set of data","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"tdv1MtnAdE"}],"key":"A4PmzEZuv5"}],"key":"jsPjbb7ZlD"}],"key":"pHzqTzgaye"}],"key":"znlNSLAqPA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#a simple example scenario of regression with python\n# 1st generate some data\nx = np.arange(0,11,1)\ny = 3.2*x + 5 + [np.random.rand()*4 for each in x]","key":"bQDY6q4t9W"},{"type":"outputs","id":"EBeNRewew2Oal1m0J-wL5","children":[],"key":"gvVzXmEr3V"}],"key":"Lla8O773Ob"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 2nd fit the data, first use np.polyfit\nfit = np.polyfit(x,y,1) #fit yields the two coefficients of the linear regression (slope and intercept)\n#if you forget what np.polyfit does, type help(np.polyfit) in the console or np.polyfit?\n# 3rd plot the data and the fit\n# 2nd plot the data\nplt.scatter(x,y)\nplt.plot(x,fit[0]*x+fit[1],'k-.',alpha=0.5)\nplt.xlabel('x'); plt.ylabel('y'); plt.show()","key":"qv2gjYjP4O"},{"type":"outputs","id":"wyjlJUJBPzBrc_8UTbi_q","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8c5d5aa8b9accd5482be9ebecf70b3c0","path":"/comptools/_public/8c5d5aa8b9accd5482be9ebecf70b3c0.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Qc5z8wlCTZ"}],"key":"ImHf7c5VAr"}],"key":"bGTW8G0zQs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Now we can calculate the R^2 and MAPE values\n# R^2\nymodel = fit[0]*x+fit[1]\nSStot = np.sum((y-np.mean(y))**2) #total sum of squares - how much different is the data from the mean\nSSE = np.sum((y-ymodel)**2) #sum of squares of the error - how much different is the data from the model\nR2 = 1 - SSE/SStot\nprint(f'R2 = {R2:.3f}')\n","key":"GR8bItN0h9"},{"type":"outputs","id":"AD1Qa39CEKgtUJWdimWHW","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"R2 = 0.987\n"},"children":[],"key":"NaCcq3GhE9"}],"key":"SCbpBqiA0C"}],"key":"Nsdu4Fdftp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now the MAPE value\nMAPE = np.mean(np.abs((y-ymodel)/y)*100)\nprint(f'MAPE = {MAPE:1.2f}%')","key":"uor6nFJFo7"},{"type":"outputs","id":"lO5dOxeeceIhouLs7Sb6A","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MAPE = 5.10%\n"},"children":[],"key":"p1MVZVlWfx"}],"key":"dqtMXIA6u7"}],"key":"PBd1mIf7kq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now we could fit the same data to a custom model using scipy.optimize.curve_fit\nfrom scipy.optimize import curve_fit\ndef mymodel(x,a,b):\n    return a*x*np.cosh(x) + b\npopt, pcov = curve_fit(mymodel,x,y)\nprint(f'popt = {popt}')\n# the same methods of R2, MAPE and plotting can be done as above","key":"UdWXUd7gJz"},{"type":"outputs","id":"rEXgB0b8_BahGFiVH86sg","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"popt = [2.20596932e-04 2.00189102e+01]\n"},"children":[],"key":"oMGgR10bS8"}],"key":"HGML5IHlwF"}],"key":"cFUm9hhMMn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Integration Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xwSiQvZ90d"}],"identifier":"integration-review","label":"Integration Review","html_id":"integration-review","implicit":true,"key":"OBy6rPHrl6"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Python quad","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"YvYCCZxMcN"}],"key":"mtpL6eTD9W"}],"key":"fxp4Qzs3ik"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Trapezoid method","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AyTrgTemKR"}],"key":"XcV4CcCtt2"}],"key":"LtrhgvlElW"}],"key":"eE64SGU4rb"}],"key":"GkitRR5Pgg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#an example of the quad function to calculate the integral of the above regressed function\nfrom scipy.integrate import quad\narea = quad(mymodel,0,10,args=(popt[0],popt[1]))[0]\nprint(f'area of mymodel fit between 0 and 10 = {area:1.2f}')","key":"BbKIuMiDn2"},{"type":"outputs","id":"IZj8s9Qw2JeGPR4xNtxhf","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"area of mymodel fit between 0 and 10 = 222.05\n"},"children":[],"key":"GIgGsRUgGJ"}],"key":"T5lsj8Q5rD"}],"key":"zqlFYY8Pq6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interpolation Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nnZIYjV1g3"}],"identifier":"interpolation-review","label":"Interpolation Review","html_id":"interpolation-review","implicit":true,"key":"ZLCtmxiGhn"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"R67TGrEqEW"}],"key":"nj5zp6pT8C"}],"key":"bpagFCfd6M"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cubic","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fVnBzt2yvF"}],"key":"YIKbRaNoVp"}],"key":"lV1fO1aGyd"}],"key":"J5qAoLRHqS"}],"key":"nkS8tUgxqG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# an example of Cubic Spline interpolation\nfrom scipy.interpolate import CubicSpline\nf = CubicSpline(x,y)\nf(3.4)","key":"SQdOXwGuJP"},{"type":"outputs","id":"slU3ZJR8M0R3S64NSjnLs","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":20,"metadata":{},"data":{"text/plain":{"content":"array(17.00692328)","content_type":"text/plain"}}},"children":[],"key":"yP7UhHRgtt"}],"key":"jScbjZhobW"}],"key":"UEIRY96CWO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Many of the same things done above can be completed in Excel. Click this link to see an example of linear regression and integration with the trapezoid method: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zsGMzAJNmC"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/LinearRegIntegrateEx​.xlsx","key":"pSGOTfx3D7"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/LinearRegIntegrateEx.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx"},"internal":false,"protocol":"github","key":"mAHawmoy
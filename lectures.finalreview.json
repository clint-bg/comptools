{"version":3,"kind":"Notebook","sha256":"c216f64c7b94072cbf4a97b909b789d48e103f22f35204337c90726adb96d434","slug":"lectures.finalreview","location":"/lectures/27-FinalReview.ipynb","dependencies":[],"frontmatter":{"title":"27 - Final Exam Review","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Clint Guymon","given":"Clint","family":"Guymon"},"name":"Clint Guymon","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Brigham Young University","given":"Brigham Young","family":"University"},"name":"Brigham Young University","id":"contributors-myst-generated-uid-1"}],"github":"https://github.com/clint-bg/comptools","numbering":{"title":{"offset":1}},"source_url":"https://github.com/clint-bg/comptools/blob/main/lectures/27-FinalReview.ipynb","edit_url":"https://github.com/clint-bg/comptools/edit/main/lectures/27-FinalReview.ipynb","exports":[{"format":"ipynb","filename":"27-FinalReview.ipynb","url":"/comptools/_public/27-FinalReview-b48a3e4293d3e5d2e8dc22a6280a15b3.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.integrate import odeint","key":"SL1AqMVYcD"},{"type":"outputs","id":"GWXjBwuferwO_IF6T4jgV","children":[],"key":"aHGQL4Xiij"}],"key":"TeMYeKDXiZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Python Basics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m9bp6jrGJo"}],"identifier":"python-basics","label":"Python Basics","html_id":"python-basics","implicit":true,"key":"kVIVuL1hqM"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Be familiar with the different variable types and understand how to use them. See the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"blyh9MI2nj"},{"type":"link","url":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Python Foundations page.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"iZJUjpM1oK"}],"urlSource":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","key":"dQL71mfng9"}],"key":"z6goJMT6SF"}],"key":"VxgO8rr54q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Functions and Objects","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IpOT7pIwNs"}],"identifier":"functions-and-objects","label":"Functions and Objects","html_id":"functions-and-objects","implicit":true,"key":"Ydjn5aBFRB"}],"key":"VnAlXX0lOm"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you sum every third number from 1007 to 2023 using python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BuJedO0Tgr"}],"key":"So1JiuoQqT"}],"key":"gNHgwhrrpG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solving Equations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"waxKJU2Le9"}],"identifier":"solving-equations","label":"Solving Equations","html_id":"solving-equations","implicit":true,"key":"zW4rybmHHT"}],"key":"GFhGOdXtIa"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you solve multiple coupled, non-linear equations in python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mEtDy0ZsU0"}],"key":"U60Fdd3vD8"}],"key":"EYsZOeh0wS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ODEInt Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lMBm34d21E"}],"identifier":"odeint-review","label":"ODEInt Review","html_id":"odeint-review","implicit":true,"key":"lvoxZjazwe"}],"key":"pyvQY3rU6N"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example of using ODEInt to solve a system of ODEs with SEIRD model (S: susceptible, E: exposed, I: infected, R: recovered, D: dead). The SEIRD model approximates the number of people infected with a contagious illness in a population. The model is expressed as a system of differential equations and is solved numerically.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wDZoPvEXV1"}],"key":"VA945DK62x"}],"key":"Ii988QJXJ4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def deriv(y, t, N, beta, gamma, delta, rho):\n    S, E, I, R, D = y\n    dSdt = -beta * S * I / N\n    dEdt = beta * S * I / N - delta * E\n    dIdt = delta * E - gamma * I - rho * I\n    dRdt = gamma * I\n    dDdt = rho * I\n    return dSdt, dEdt, dIdt, dRdt, dDdt","key":"AXPFkSIbOo"},{"type":"outputs","id":"LE7BwdKDhnj-IXJQsBU77","children":[],"key":"p2ncAlspAz"}],"key":"l8uVlRzz8C"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#initial values\nN = 1000000\nD = 14.0\ngamma = 1.0 / D\ndelta = 1.0 / 5.0\nrho = 0.01\nbeta = 2.5 * gamma\nS0, E0, I0, R0, D0 = N-1, 1, 0, 0, 0\ny = S0, E0, I0, R0, D0","key":"Lxv6JnodgD"},{"type":"outputs","id":"lBqYP0kdDQ067SpbC8JJU","children":[],"key":"DdUkh1dxaZ"}],"key":"jFsG9JCc6H"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# solution\nt = np.linspace(0, 365, 365)\nsol = odeint(deriv, y, t, args=(N, beta, gamma, delta, rho))","key":"hTu8AK1kqL"},{"type":"outputs","id":"xyb9k89VK1sF3swIQrNW8","children":[],"key":"fGWsvAqplz"}],"key":"ggJtCcBtjS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.shape","key":"AWFOvDdC3f"},{"type":"outputs","id":"nlhaA7hV2EoUaPdzjJ4b1","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":35,"metadata":{},"data":{"text/plain":{"content":"(365, 5)","content_type":"text/plain"}}},"children":[],"key":"zehzmagXQD"}],"key":"USNwGJktSt"}],"key":"Qzqur72d97"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.T.shape","key":"T6jZLvYhmW"},{"type":"outputs","id":"2FM5YNHcl5GouKAYuWD8q","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":34,"metadata":{},"data":{"text/plain":{"content":"(5, 365)","content_type":"text/plain"}}},"children":[],"key":"fMNdACTEoJ"}],"key":"PR37z6Kevb"}],"key":"ZZ0ShEmkue"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We’ll transpose the solution with the .T operator so that we can plot the solution for each variable as a function of time.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l1XEDhfU1G"}],"key":"scshprvR6F"}],"key":"Jv2nHFDllA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#plot results\nS, E, I, R, D = sol.T\nfig = plt.figure(facecolor='w')\nax = fig.add_subplot(111, axisbelow=True)\nax.plot(t, S/1000, 'b', alpha=0.5, lw=2, label='Susceptible')\nax.plot(t, E/1000, 'y', alpha=0.5, lw=2, label='Exposed')\nax.plot(t, I/1000, 'r', alpha=0.5, lw=2, label='Infected')\nax.plot(t, R/1000, 'g', alpha=0.5, lw=2, label='Recovered with immunity')\nax.plot(t, D/1000, 'k', alpha=0.5, lw=2, label='Dead')\nax.set_xlabel('Time /days')\nax.set_ylabel('Number (1000s)')\nax.set_ylim(0,1200)\nax.set_xlim(0,365)\n#ax.grid(b=True, which='major', c='w', lw=2, ls='-')\nlegend = ax.legend()\nlegend.get_frame().set_alpha(0.5)\nplt.show()","key":"kuvWQw3BaK"},{"type":"outputs","id":"GNqxXOHmztgtZ4bUKQxpC","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ea6e04932ae561f3922057d93a013b2","path":"/comptools/_public/4ea6e04932ae561f3922057d93a013b2.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"qwdQsUXFM0"}],"key":"niV5O9QPEp"}],"key":"gz5UaSfuiZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Doing the same integration of the SEIRD model in Excel using Euler’s method is given here: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xrWQKPRnW8"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/inclasseulerdisease​.xlsx","key":"QhoD3RWFfq"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/inclasseulerdisease.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/inclasseulerdisease.xlsx"},"internal":false,"protocol":"github","key":"TJp61FeHsX"}],"key":"i3wWHMPN1t"}],"key":"JVyMACyC8X"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Regression Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cY7SQkJLOh"}],"identifier":"regression-review","label":"Regression Review","html_id":"regression-review","implicit":true,"key":"xPbeh8HWCG"}],"key":"fc1gAH49Kv"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Different methods of regression include:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"posFZBQnmz"}],"key":"JxuFa5WqQP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear Regression","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"anTP7uWGhg"}],"key":"kFVAfCXZc5"}],"key":"Ms3kKMfNWn"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Polynomial Regression","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YRepu3cXgC"}],"key":"hjAewLvn19"}],"key":"PgNHpOGwgj"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Custom relationship using curve_fit or least_squares or minimize","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"hNbwy8hU8E"}],"key":"RAqciyOYKX"}],"key":"hGsJtIQOxJ"}],"key":"JRrVxmVfaB"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Examples could include:","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"MFLVaScizV"}],"key":"gtm4u3aUv6"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a line to a set of data","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"VfsOTAejTu"}],"key":"wGfoQ1UCg5"}],"key":"uRnyKpUWqe"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a polynomial to a set of data","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"EbqNdn8kfv"}],"key":"AvO13mqJxl"}],"key":"tszdY2yPYZ"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a custom relationship to a set of data","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"IINsTck57G"}],"key":"DqoD5gOoz9"}],"key":"XU8IaDjDuM"}],"key":"lafNNiH4VL"}],"key":"hxwPZizMNC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#a simple example scenario of regression with python\n# 1st generate some data\nx = np.arange(0,11,1)\ny = 3.2*x + 5 + [np.random.rand()*4 for each in x]","key":"dK5e6uGBg6"},{"type":"outputs","id":"qDTjNaVbae7M4bEvNqHQd","children":[],"key":"SuOTFUFDem"}],"key":"Dpajm5E2EC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 2nd fit the data, first use np.polyfit\nfit = np.polyfit(x,y,1) #fit yields the two coefficients of the linear regression (slope and intercept)\n#if you forget what np.polyfit does, type help(np.polyfit) in the console or np.polyfit?\n# 3rd plot the data and the fit\n# 2nd plot the data\nplt.scatter(x,y)\nplt.plot(x,fit[0]*x+fit[1],'k-.',alpha=0.5)\nplt.xlabel('x'); plt.ylabel('y'); plt.show()","key":"oBBPwiF3Kj"},{"type":"outputs","id":"BcUPQVqUXP9C5T95spivp","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8c5d5aa8b9accd5482be9ebecf70b3c0","path":"/comptools/_public/8c5d5aa8b9accd5482be9ebecf70b3c0.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"gSXhOVSrWL"}],"key":"bjZaz2PvFO"}],"key":"qt2rp1NsAm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Now we can calculate the R^2 and MAPE values\n# R^2\nymodel = fit[0]*x+fit[1]\nSStot = np.sum((y-np.mean(y))**2) #total sum of squares - how much different is the data from the mean\nSSE = np.sum((y-ymodel)**2) #sum of squares of the error - how much different is the data from the model\nR2 = 1 - SSE/SStot\nprint(f'R2 = {R2:.3f}')\n","key":"YX5Gc01sTe"},{"type":"outputs","id":"KqzlK67U5iYIEp3XwOnV_","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"R2 = 0.987\n"},"children":[],"key":"mXO6Vn9CqI"}],"key":"AQ6llQ1bdm"}],"key":"yMAm31M7qq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now the MAPE value\nMAPE = np.mean(np.abs((y-ymodel)/y)*100)\nprint(f'MAPE = {MAPE:1.2f}%')","key":"cEru4jv6Ol"},{"type":"outputs","id":"kqJ6mUXE2vOmIYMJ-SRrI","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MAPE = 5.10%\n"},"children":[],"key":"X5NwzwP1yF"}],"key":"o5E2lx9qaI"}],"key":"bLL3NemCfP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now we could fit the same data to a custom model using scipy.optimize.curve_fit\nfrom scipy.optimize import curve_fit\ndef mymodel(x,a,b):\n    return a*x*np.cosh(x) + b\npopt, pcov = curve_fit(mymodel,x,y)\nprint(f'popt = {popt}')\n# the same methods of R2, MAPE and plotting can be done as above","key":"athRTxlqmg"},{"type":"outputs","id":"BSOx8euUt5Q996ESfmpCC","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"popt = [2.20596932e-04 2.00189102e+01]\n"},"children":[],"key":"hSaGJlyAOE"}],"key":"K7Y3Oh2v02"}],"key":"fZCxXhS81L"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Integration Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"W63qeXoHWT"}],"identifier":"integration-review","label":"Integration Review","html_id":"integration-review","implicit":true,"key":"nJ7L9g9kbl"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Python quad","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"s8Xe0vSRef"}],"key":"CptwKemfEK"}],"key":"fniF321Mfe"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Trapezoid method","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"glo6ZR7lP6"}],"key":"PuaPgpncvQ"}],"key":"QwaQGpM76d"}],"key":"DWb3Lk0zhN"}],"key":"cttjlAOkn8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#an example of the quad function to calculate the integral of the above regressed function\nfrom scipy.integrate import quad\narea = quad(mymodel,0,10,args=(popt[0],popt[1]))[0]\nprint(f'area of mymodel fit between 0 and 10 = {area:1.2f}')","key":"DHItERhgY8"},{"type":"outputs","id":"RyUZHBCYaQxwuyZ6SYjzL","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"area of mymodel fit between 0 and 10 = 222.05\n"},"children":[],"key":"E1QGSQGnKm"}],"key":"hWTdXIWgcC"}],"key":"whj78JK7CJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interpolation Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bJExKgwkea"}],"identifier":"interpolation-review","label":"Interpolation Review","html_id":"interpolation-review","implicit":true,"key":"J9p1jq1aAe"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"hMw6m6Ggul"}],"key":"BGEw52ruqk"}],"key":"skD34LNoKG"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cubic","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NIwQYlRuZQ"}],"key":"KZLx4qm3OO"}],"key":"tmQxVohX0b"}],"key":"pvBFljOmgC"}],"key":"NaUsKZ417c"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# an example of Cubic Spline interpolation\nfrom scipy.interpolate import CubicSpline\nf = CubicSpline(x,y)\nf(3.4)","key":"miKQk4jxjr"},{"type":"outputs","id":"7n-8zOmWm6te4nFvMsA2E","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":20,"metadata":{},"data":{"text/plain":{"content":"array(17.00692328)","content_type":"text/plain"}}},"children":[],"key":"jqr1FHA0GG"}],"key":"m0UliAcrXY"}],"key":"GSqiKivsc0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Many of the same things done above can be completed in Excel. Click this link to see an example of linear regression and integration with the trapezoid method: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rnnJpZRoMh"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/LinearRegIntegrateEx​.xlsx","key":"QiMAkCCJD1"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/LinearRegIntegrateEx.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx"},"internal":false,"protocol":"github","key":"GeRxL2CL
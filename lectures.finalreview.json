{"version":3,"kind":"Notebook","sha256":"c216f64c7b94072cbf4a97b909b789d48e103f22f35204337c90726adb96d434","slug":"lectures.finalreview","location":"/lectures/27-FinalReview.ipynb","dependencies":[],"frontmatter":{"title":"27 - Final Exam Review","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Clint Guymon","given":"Clint","family":"Guymon"},"name":"Clint Guymon","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Brigham Young University","given":"Brigham Young","family":"University"},"name":"Brigham Young University","id":"contributors-myst-generated-uid-1"}],"github":"https://github.com/clint-bg/comptools","numbering":{"title":{"offset":1}},"source_url":"https://github.com/clint-bg/comptools/blob/main/lectures/27-FinalReview.ipynb","edit_url":"https://github.com/clint-bg/comptools/edit/main/lectures/27-FinalReview.ipynb","exports":[{"format":"ipynb","filename":"27-FinalReview.ipynb","url":"/comptools/_public/27-FinalReview-b48a3e4293d3e5d2e8dc22a6280a15b3.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.integrate import odeint","key":"C2DyjktyZC"},{"type":"outputs","id":"b9MyKKDXDw__uf8FwTOwr","children":[],"key":"XNhiuPEwte"}],"key":"hZUhYuig0a"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Python Basics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dmPcFyrGUp"}],"identifier":"python-basics","label":"Python Basics","html_id":"python-basics","implicit":true,"key":"sSqtt6DsbE"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Be familiar with the different variable types and understand how to use them. See the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"stVwrzytBx"},{"type":"link","url":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Python Foundations page.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"Nco2F0AvFV"}],"urlSource":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","key":"xivgVfgb1k"}],"key":"CTLIhFn1Pi"}],"key":"lJ7DQ3ncsG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Functions and Objects","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZTjlsQVVaQ"}],"identifier":"functions-and-objects","label":"Functions and Objects","html_id":"functions-and-objects","implicit":true,"key":"UFhFR9qsMw"}],"key":"qUKkQ3vYtA"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you sum every third number from 1007 to 2023 using python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"alwqqwHIg2"}],"key":"DoptsgCFfG"}],"key":"df51QcFzjK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solving Equations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"A99LCN6tyG"}],"identifier":"solving-equations","label":"Solving Equations","html_id":"solving-equations","implicit":true,"key":"FMIN7tgIds"}],"key":"tPKZKB916h"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you solve multiple coupled, non-linear equations in python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NV1cHBi7kP"}],"key":"ppVCRytUBA"}],"key":"Z5Bj6B9Vhk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ODEInt Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"gMQKJLJTXf"}],"identifier":"odeint-review","label":"ODEInt Review","html_id":"odeint-review","implicit":true,"key":"pFPxKQBzpY"}],"key":"UiNnagw0Jq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example of using ODEInt to solve a system of ODEs with SEIRD model (S: susceptible, E: exposed, I: infected, R: recovered, D: dead). The SEIRD model approximates the number of people infected with a contagious illness in a population. The model is expressed as a system of differential equations and is solved numerically.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kejALTUJrZ"}],"key":"Hgjp1sgPgW"}],"key":"n1iPafpooO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def deriv(y, t, N, beta, gamma, delta, rho):\n    S, E, I, R, D = y\n    dSdt = -beta * S * I / N\n    dEdt = beta * S * I / N - delta * E\n    dIdt = delta * E - gamma * I - rho * I\n    dRdt = gamma * I\n    dDdt = rho * I\n    return dSdt, dEdt, dIdt, dRdt, dDdt","key":"S5q0sjy1Kl"},{"type":"outputs","id":"x2nbFvyKBystsRHce2e1r","children":[],"key":"J7DVE34UHB"}],"key":"olcST9nrde"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#initial values\nN = 1000000\nD = 14.0\ngamma = 1.0 / D\ndelta = 1.0 / 5.0\nrho = 0.01\nbeta = 2.5 * gamma\nS0, E0, I0, R0, D0 = N-1, 1, 0, 0, 0\ny = S0, E0, I0, R0, D0","key":"g5WvE6C8eN"},{"type":"outputs","id":"BEIOW0_Sgg8Z7L6FqrgCU","children":[],"key":"M8ZCZGoqLw"}],"key":"DudZCHeNSS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# solution\nt = np.linspace(0, 365, 365)\nsol = odeint(deriv, y, t, args=(N, beta, gamma, delta, rho))","key":"lfuvszt6AV"},{"type":"outputs","id":"eD_rEbzeGvs7vm0iJDLTZ","children":[],"key":"mWePNjVyoN"}],"key":"V8jy4ZqGss"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.shape","key":"jm9EVVQfFf"},{"type":"outputs","id":"7O8B-KFkI-cGFgplCu1fZ","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":35,"metadata":{},"data":{"text/plain":{"content":"(365, 5)","content_type":"text/plain"}}},"children":[],"key":"SN3Tmf6W2u"}],"key":"fuWHdiUspX"}],"key":"f27qpZFicC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.T.shape","key":"yCaZ2kCjDv"},{"type":"outputs","id":"C7fpaLf8PyKpDYw9RVf-s","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":34,"metadata":{},"data":{"text/plain":{"content":"(5, 365)","content_type":"text/plain"}}},"children":[],"key":"Yeioviofez"}],"key":"v09wADs3QP"}],"key":"nR91sTz49K"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We’ll transpose the solution with the .T operator so that we can plot the solution for each variable as a function of time.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KQsTI1hiql"}],"key":"gwcnD7QAIQ"}],"key":"wNnouB8BGN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#plot results\nS, E, I, R, D = sol.T\nfig = plt.figure(facecolor='w')\nax = fig.add_subplot(111, axisbelow=True)\nax.plot(t, S/1000, 'b', alpha=0.5, lw=2, label='Susceptible')\nax.plot(t, E/1000, 'y', alpha=0.5, lw=2, label='Exposed')\nax.plot(t, I/1000, 'r', alpha=0.5, lw=2, label='Infected')\nax.plot(t, R/1000, 'g', alpha=0.5, lw=2, label='Recovered with immunity')\nax.plot(t, D/1000, 'k', alpha=0.5, lw=2, label='Dead')\nax.set_xlabel('Time /days')\nax.set_ylabel('Number (1000s)')\nax.set_ylim(0,1200)\nax.set_xlim(0,365)\n#ax.grid(b=True, which='major', c='w', lw=2, ls='-')\nlegend = ax.legend()\nlegend.get_frame().set_alpha(0.5)\nplt.show()","key":"qwKSBg50Kp"},{"type":"outputs","id":"2e3tUaKnkQWVet52sgayP","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ea6e04932ae561f3922057d93a013b2","path":"/comptools/_public/4ea6e04932ae561f3922057d93a013b2.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"HHImpRzI3Z"}],"key":"uc6htCnmBN"}],"key":"VTLoJzWHd0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Doing the same integration of the SEIRD model in Excel using Euler’s method is given here: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zk942H74bo"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/inclasseulerdisease​.xlsx","key":"K54iHNuaZR"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/inclasseulerdisease.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/inclasseulerdisease.xlsx"},"internal":false,"protocol":"github","key":"UjoJ27K6yo"}],"key":"UTZdGAHWab"}],"key":"pAePMJQPnA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Regression Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"joDvnZZCMJ"}],"identifier":"regression-review","label":"Regression Review","html_id":"regression-review","implicit":true,"key":"HRShrGik4v"}],"key":"Wgq3vxi5RB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Different methods of regression include:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tA2JhU9QZW"}],"key":"JHs5xIKCpC"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear Regression","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"M4g0abI3Gt"}],"key":"ALZNM3LSVF"}],"key":"uRqIy5brX1"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Polynomial Regression","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SA6Er5gT7t"}],"key":"MbohKZG7AR"}],"key":"zZYjVWodnh"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Custom relationship using curve_fit or least_squares or minimize","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nWP2TrO0zq"}],"key":"VtfKTXVVYF"}],"key":"vha6Xz0d6P"}],"key":"ZiauCzVquw"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Examples could include:","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"dbCCAgDo0x"}],"key":"Ecnu1fjVH8"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a line to a set of data","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Tgzf7Mp0Q6"}],"key":"VpEu8mpHl0"}],"key":"jXHCClWtsJ"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a polynomial to a set of data","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Bh8uvEGazr"}],"key":"I98K1rBPxu"}],"key":"gbr8bvUqVi"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a custom relationship to a set of data","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"zCRuCAVFVq"}],"key":"cKt7U1L8iC"}],"key":"dEaU3NaLIo"}],"key":"gU3NzBlJMQ"}],"key":"i1GugsKve4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#a simple example scenario of regression with python\n# 1st generate some data\nx = np.arange(0,11,1)\ny = 3.2*x + 5 + [np.random.rand()*4 for each in x]","key":"D7ZwjlXuJB"},{"type":"outputs","id":"UR1Olx5h1T76WzkbUO_Uf","children":[],"key":"WBKc9QMbXM"}],"key":"PQzIlqKrhX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 2nd fit the data, first use np.polyfit\nfit = np.polyfit(x,y,1) #fit yields the two coefficients of the linear regression (slope and intercept)\n#if you forget what np.polyfit does, type help(np.polyfit) in the console or np.polyfit?\n# 3rd plot the data and the fit\n# 2nd plot the data\nplt.scatter(x,y)\nplt.plot(x,fit[0]*x+fit[1],'k-.',alpha=0.5)\nplt.xlabel('x'); plt.ylabel('y'); plt.show()","key":"zea7Me0bSX"},{"type":"outputs","id":"Y9wEKeshi5mTEnif_eJmk","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8c5d5aa8b9accd5482be9ebecf70b3c0","path":"/comptools/_public/8c5d5aa8b9accd5482be9ebecf70b3c0.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"j6AJpMfvke"}],"key":"h2Krc0Cl1h"}],"key":"zoilyCdyDT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Now we can calculate the R^2 and MAPE values\n# R^2\nymodel = fit[0]*x+fit[1]\nSStot = np.sum((y-np.mean(y))**2) #total sum of squares - how much different is the data from the mean\nSSE = np.sum((y-ymodel)**2) #sum of squares of the error - how much different is the data from the model\nR2 = 1 - SSE/SStot\nprint(f'R2 = {R2:.3f}')\n","key":"iaEgWRMVU0"},{"type":"outputs","id":"DhUm0bNwsV-VH3_zp1UtH","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"R2 = 0.987\n"},"children":[],"key":"EYpNJHoUjy"}],"key":"WzZrHm0ef8"}],"key":"tR2avSBh7K"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now the MAPE value\nMAPE = np.mean(np.abs((y-ymodel)/y)*100)\nprint(f'MAPE = {MAPE:1.2f}%')","key":"YTdxYnSWgo"},{"type":"outputs","id":"UBVrVY_NRak9QHZ8YmYVV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MAPE = 5.10%\n"},"children":[],"key":"IX6qog9QVj"}],"key":"afP7JoReFk"}],"key":"w0AUNrAe4Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now we could fit the same data to a custom model using scipy.optimize.curve_fit\nfrom scipy.optimize import curve_fit\ndef mymodel(x,a,b):\n    return a*x*np.cosh(x) + b\npopt, pcov = curve_fit(mymodel,x,y)\nprint(f'popt = {popt}')\n# the same methods of R2, MAPE and plotting can be done as above","key":"gqzrKKSum5"},{"type":"outputs","id":"d-MPdyMlXJ_C6OOvCUaMa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"popt = [2.20596932e-04 2.00189102e+01]\n"},"children":[],"key":"BnOj3YQAgr"}],"key":"yQkIl5rL8Z"}],"key":"SGbPPHSWIS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Integration Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"uawJJKhO2u"}],"identifier":"integration-review","label":"Integration Review","html_id":"integration-review","implicit":true,"key":"TKJNOQ7Mqj"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Python quad","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"wfJg8gK4Sn"}],"key":"jwNUkSAVjF"}],"key":"itk2wfADry"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Trapezoid method","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"q5ybWj6Rd6"}],"key":"o9b2E5oWoe"}],"key":"AYoj1m4GQ2"}],"key":"XMkg81JAgx"}],"key":"KElCX0VJIQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#an example of the quad function to calculate the integral of the above regressed function\nfrom scipy.integrate import quad\narea = quad(mymodel,0,10,args=(popt[0],popt[1]))[0]\nprint(f'area of mymodel fit between 0 and 10 = {area:1.2f}')","key":"hK5YNufEPO"},{"type":"outputs","id":"CtsIYuQvg2_6T9pj1znuO","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"area of mymodel fit between 0 and 10 = 222.05\n"},"children":[],"key":"dEkkMLDnCZ"}],"key":"DKkYH21dcg"}],"key":"JG7LzXR1PK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interpolation Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"DSJYM8lQTp"}],"identifier":"interpolation-review","label":"Interpolation Review","html_id":"interpolation-review","implicit":true,"key":"e9MBg3Dhbw"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ypHqyxon2l"}],"key":"jgOdwkXSsd"}],"key":"SDqiBZbppr"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cubic","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AfX4ABdLih"}],"key":"YRY7uqksXd"}],"key":"t87tRCNRDY"}],"key":"zOoBtsH9qd"}],"key":"MRnETtxZD7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# an example of Cubic Spline interpolation\nfrom scipy.interpolate import CubicSpline\nf = CubicSpline(x,y)\nf(3.4)","key":"eZ60y9vkt2"},{"type":"outputs","id":"wpRVwDpaB0105x8p6FlMl","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":20,"metadata":{},"data":{"text/plain":{"content":"array(17.00692328)","content_type":"text/plain"}}},"children":[],"key":"htkeodhcmR"}],"key":"tkEgUmmQHF"}],"key":"zT52QJLvi0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Many of the same things done above can be completed in Excel. Click this link to see an example of linear regression and integration with the trapezoid method: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"feQTDy3Pn4"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/LinearRegIntegrateEx​.xlsx","key":"M1x7iLlnCa"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/LinearRegIntegrateEx.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx"},"internal":false,"protocol":"github","key":"dwTKx5AS
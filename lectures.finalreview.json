{"version":3,"kind":"Notebook","sha256":"c216f64c7b94072cbf4a97b909b789d48e103f22f35204337c90726adb96d434","slug":"lectures.finalreview","location":"/lectures/27-FinalReview.ipynb","dependencies":[],"frontmatter":{"title":"27 - Final Exam Review","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Clint Guymon","given":"Clint","family":"Guymon"},"name":"Clint Guymon","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Brigham Young University","given":"Brigham Young","family":"University"},"name":"Brigham Young University","id":"contributors-myst-generated-uid-1"}],"github":"https://github.com/clint-bg/comptools","numbering":{"title":{"offset":1}},"source_url":"https://github.com/clint-bg/comptools/blob/main/lectures/27-FinalReview.ipynb","edit_url":"https://github.com/clint-bg/comptools/edit/main/lectures/27-FinalReview.ipynb","exports":[{"format":"ipynb","filename":"27-FinalReview.ipynb","url":"/comptools/_public/27-FinalReview-b48a3e4293d3e5d2e8dc22a6280a15b3.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.integrate import odeint","key":"XdLwdHANLI"},{"type":"outputs","id":"JCmbsm44A-Vca7W4icWgH","children":[],"key":"bUze97ABKw"}],"key":"ELXIAnMJiZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Python Basics","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vBC2LDzVse"}],"identifier":"python-basics","label":"Python Basics","html_id":"python-basics","implicit":true,"key":"Yt99euNq0E"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Be familiar with the different variable types and understand how to use them. See the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"RfquEpzxGI"},{"type":"link","url":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Python Foundations page.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"dy3Ikcq2Iw"}],"urlSource":"https://clint-bg.github.io/comptools/foundations/pythonresources.html","key":"iExSm6tUIe"}],"key":"s4YrDM9oLg"}],"key":"Cf2weJ3YKE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Functions and Objects","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dy9uI3HBiC"}],"identifier":"functions-and-objects","label":"Functions and Objects","html_id":"functions-and-objects","implicit":true,"key":"KZ6YTvs99R"}],"key":"Wz9MUOHm42"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you sum every third number from 1007 to 2023 using python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JtNvRqvNLW"}],"key":"XkKrjZu3uj"}],"key":"kbfmekS0Tq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Solving Equations","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jTpRaTgmYl"}],"identifier":"solving-equations","label":"Solving Equations","html_id":"solving-equations","implicit":true,"key":"DOl1GPJhFf"}],"key":"fSjb8dtQjV"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"How would you solve multiple coupled, non-linear equations in python? Can you set that up as a function? Can you now set that function up as part of an object?","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mRz80o7vaG"}],"key":"kxFiaM6Fkj"}],"key":"fSQCnQW7jW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ODEInt Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RQlX1ko2pz"}],"identifier":"odeint-review","label":"ODEInt Review","html_id":"odeint-review","implicit":true,"key":"bAWiP7ChNF"}],"key":"KP0uuD9pb1"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Example of using ODEInt to solve a system of ODEs with SEIRD model (S: susceptible, E: exposed, I: infected, R: recovered, D: dead). The SEIRD model approximates the number of people infected with a contagious illness in a population. The model is expressed as a system of differential equations and is solved numerically.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rZmKgTBd4z"}],"key":"Znjwecl3rv"}],"key":"yRhswZk53l"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def deriv(y, t, N, beta, gamma, delta, rho):\n    S, E, I, R, D = y\n    dSdt = -beta * S * I / N\n    dEdt = beta * S * I / N - delta * E\n    dIdt = delta * E - gamma * I - rho * I\n    dRdt = gamma * I\n    dDdt = rho * I\n    return dSdt, dEdt, dIdt, dRdt, dDdt","key":"kK5LjMLZkn"},{"type":"outputs","id":"xeGpnJSOoV-KIagm9qBZi","children":[],"key":"FfwO2Om5e4"}],"key":"EhbvHMBs5y"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#initial values\nN = 1000000\nD = 14.0\ngamma = 1.0 / D\ndelta = 1.0 / 5.0\nrho = 0.01\nbeta = 2.5 * gamma\nS0, E0, I0, R0, D0 = N-1, 1, 0, 0, 0\ny = S0, E0, I0, R0, D0","key":"tblIC6lNgk"},{"type":"outputs","id":"kh2nyrkqFpDOSnqrKmwYj","children":[],"key":"M1ymJLE2Lh"}],"key":"o9dGDfPUAS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# solution\nt = np.linspace(0, 365, 365)\nsol = odeint(deriv, y, t, args=(N, beta, gamma, delta, rho))","key":"WWzwWC2hOk"},{"type":"outputs","id":"tMYDAqpcxPonxkI61Fz8z","children":[],"key":"kuU4sYLKY5"}],"key":"eeYHBWckGP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.shape","key":"EshQwXEs42"},{"type":"outputs","id":"X89Box4fZ7VZaIIvDBE7o","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":35,"metadata":{},"data":{"text/plain":{"content":"(365, 5)","content_type":"text/plain"}}},"children":[],"key":"QfyOhwStf9"}],"key":"cJpfiokk7R"}],"key":"jSc3Y6DAPr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol.T.shape","key":"AFZU9RGqRo"},{"type":"outputs","id":"4obP1ZE5dDJZuAxFspWZN","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":34,"metadata":{},"data":{"text/plain":{"content":"(5, 365)","content_type":"text/plain"}}},"children":[],"key":"bXIVwVMSke"}],"key":"Iyoyjsy7bC"}],"key":"UeY9oSeX5O"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"We’ll transpose the solution with the .T operator so that we can plot the solution for each variable as a function of time.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YKgVjlZWev"}],"key":"nWZs9GJfpU"}],"key":"Clb5aRkP4z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#plot results\nS, E, I, R, D = sol.T\nfig = plt.figure(facecolor='w')\nax = fig.add_subplot(111, axisbelow=True)\nax.plot(t, S/1000, 'b', alpha=0.5, lw=2, label='Susceptible')\nax.plot(t, E/1000, 'y', alpha=0.5, lw=2, label='Exposed')\nax.plot(t, I/1000, 'r', alpha=0.5, lw=2, label='Infected')\nax.plot(t, R/1000, 'g', alpha=0.5, lw=2, label='Recovered with immunity')\nax.plot(t, D/1000, 'k', alpha=0.5, lw=2, label='Dead')\nax.set_xlabel('Time /days')\nax.set_ylabel('Number (1000s)')\nax.set_ylim(0,1200)\nax.set_xlim(0,365)\n#ax.grid(b=True, which='major', c='w', lw=2, ls='-')\nlegend = ax.legend()\nlegend.get_frame().set_alpha(0.5)\nplt.show()","key":"ZpYOnu4aFF"},{"type":"outputs","id":"2_owMPGRcqmRCEX55KNxY","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"4ea6e04932ae561f3922057d93a013b2","path":"/comptools/_public/4ea6e04932ae561f3922057d93a013b2.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"ZOHc0Ehybw"}],"key":"uAZ0Nzct0x"}],"key":"HnWqGvlQjO"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Doing the same integration of the SEIRD model in Excel using Euler’s method is given here: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"u5hP3D80Jt"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/inclasseulerdisease​.xlsx","key":"IADfrhp0nk"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/inclasseulerdisease.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/inclasseulerdisease.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/inclasseulerdisease.xlsx"},"internal":false,"protocol":"github","key":"Ek4q2rkn8q"}],"key":"NrlHlcoySB"}],"key":"kdnTds7iof"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Regression Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HhP80CKo5y"}],"identifier":"regression-review","label":"Regression Review","html_id":"regression-review","implicit":true,"key":"ZmB8GFKVil"}],"key":"lJ40KcDaTx"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Different methods of regression include:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bPfjM1ZGvn"}],"key":"zB2fi9g57X"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear Regression","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"BrAAdL4Vk5"}],"key":"gG7sZzlujQ"}],"key":"SVS4rMStlf"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Polynomial Regression","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FAmkDQ8JKa"}],"key":"vvNvuR0FG4"}],"key":"bMT5kkri6t"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Custom relationship using curve_fit or least_squares or minimize","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"URUp3Oj0q2"}],"key":"Xww48tuSDT"}],"key":"yedPDdFDlC"}],"key":"BFjENIKOXf"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Examples could include:","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"JoAH9uQMUN"}],"key":"ttAbF0WdUF"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a line to a set of data","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"SVjUQBidaI"}],"key":"htG4YgkQdk"}],"key":"H1oFYt18IB"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a polynomial to a set of data","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"JbA6uMqOsT"}],"key":"PaHX2PFDUX"}],"key":"j82wQKuclq"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting a custom relationship to a set of data","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"VqN8Ret4eZ"}],"key":"Psv6lEhxtO"}],"key":"hi9Xb39uyI"}],"key":"si6hE26Koj"}],"key":"ZriIlNRHgj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#a simple example scenario of regression with python\n# 1st generate some data\nx = np.arange(0,11,1)\ny = 3.2*x + 5 + [np.random.rand()*4 for each in x]","key":"Z9yLnvw8yF"},{"type":"outputs","id":"5LszPJ1a2YfkW8L42ZrIb","children":[],"key":"bZ3T6Src2d"}],"key":"UY1MlLtVc4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 2nd fit the data, first use np.polyfit\nfit = np.polyfit(x,y,1) #fit yields the two coefficients of the linear regression (slope and intercept)\n#if you forget what np.polyfit does, type help(np.polyfit) in the console or np.polyfit?\n# 3rd plot the data and the fit\n# 2nd plot the data\nplt.scatter(x,y)\nplt.plot(x,fit[0]*x+fit[1],'k-.',alpha=0.5)\nplt.xlabel('x'); plt.ylabel('y'); plt.show()","key":"BJJpB659vQ"},{"type":"outputs","id":"Jh2YlT4KhY0ar5a2ac7cC","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"8c5d5aa8b9accd5482be9ebecf70b3c0","path":"/comptools/_public/8c5d5aa8b9accd5482be9ebecf70b3c0.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"gHAw2yAVmN"}],"key":"lodrK5AAOw"}],"key":"ANx4EpdWeA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Now we can calculate the R^2 and MAPE values\n# R^2\nymodel = fit[0]*x+fit[1]\nSStot = np.sum((y-np.mean(y))**2) #total sum of squares - how much different is the data from the mean\nSSE = np.sum((y-ymodel)**2) #sum of squares of the error - how much different is the data from the model\nR2 = 1 - SSE/SStot\nprint(f'R2 = {R2:.3f}')\n","key":"LBDz4dIjRo"},{"type":"outputs","id":"7lzbcYiQyAMRCsplsJsWz","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"R2 = 0.987\n"},"children":[],"key":"xsgrKH1J7K"}],"key":"GBQGD2xvow"}],"key":"JhzFIRXuic"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now the MAPE value\nMAPE = np.mean(np.abs((y-ymodel)/y)*100)\nprint(f'MAPE = {MAPE:1.2f}%')","key":"arwBHlsAwu"},{"type":"outputs","id":"50YD8wOnH5GTTSIc2O9Nk","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"MAPE = 5.10%\n"},"children":[],"key":"NKvHUpBxjh"}],"key":"S1chTy7r7V"}],"key":"KqCyAddEBG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#Now we could fit the same data to a custom model using scipy.optimize.curve_fit\nfrom scipy.optimize import curve_fit\ndef mymodel(x,a,b):\n    return a*x*np.cosh(x) + b\npopt, pcov = curve_fit(mymodel,x,y)\nprint(f'popt = {popt}')\n# the same methods of R2, MAPE and plotting can be done as above","key":"c5g2fgj8MQ"},{"type":"outputs","id":"MJY4DN54t0txdx-VTUEfH","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"popt = [2.20596932e-04 2.00189102e+01]\n"},"children":[],"key":"B3SqkOYkA9"}],"key":"AauUend5vY"}],"key":"PBYqld36Qu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Integration Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ajxiXq32cf"}],"identifier":"integration-review","label":"Integration Review","html_id":"integration-review","implicit":true,"key":"wMH6vlKCGh"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Python quad","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"FC7TfuliLO"}],"key":"vfF2Utw6JC"}],"key":"fgEWKqmtI1"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Trapezoid method","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pbIfbxsTXC"}],"key":"y0zolODX99"}],"key":"TtxGxLUhtG"}],"key":"jBQTVtembr"}],"key":"MhmGs4zmI6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#an example of the quad function to calculate the integral of the above regressed function\nfrom scipy.integrate import quad\narea = quad(mymodel,0,10,args=(popt[0],popt[1]))[0]\nprint(f'area of mymodel fit between 0 and 10 = {area:1.2f}')","key":"LXhIps7Byu"},{"type":"outputs","id":"A1GRArtCPJPKs6BrPC6hn","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"area of mymodel fit between 0 and 10 = 222.05\n"},"children":[],"key":"EBS0oDmxfP"}],"key":"pTRCCIR5Tn"}],"key":"Lo4b2DEL2W"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Interpolation Review","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IXTxjegK0q"}],"identifier":"interpolation-review","label":"Interpolation Review","html_id":"interpolation-review","implicit":true,"key":"Qg5O1aoK5B"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Linear","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"QA3VvEw2s5"}],"key":"h3t9LglMlX"}],"key":"rdn4cbsWsR"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Cubic","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aQ0v3ddRhr"}],"key":"QoYpICA5ti"}],"key":"oCRoWnhnWJ"}],"key":"ouzlynj0s0"}],"key":"ClxIg97l10"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# an example of Cubic Spline interpolation\nfrom scipy.interpolate import CubicSpline\nf = CubicSpline(x,y)\nf(3.4)","key":"Xev970Fiw8"},{"type":"outputs","id":"ybZ-wI3PoRxV_ni2-avgx","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":20,"metadata":{},"data":{"text/plain":{"content":"array(17.00692328)","content_type":"text/plain"}}},"children":[],"key":"DvuN14aWns"}],"key":"o0GJvq0MPq"}],"key":"RmusKD5Aqz"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Many of the same things done above can be completed in Excel. Click this link to see an example of linear regression and integration with the trapezoid method: ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZkbPT513ay"},{"type":"link","url":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"lectures​/supportfiles​/LinearRegIntegrateEx​.xlsx","key":"zTHrXQJmy8"}],"urlSource":"https://github.com/clint-bg/comptools/blob/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx?raw=true","data":{"kind":"file","org":"clint-bg","repo":"comptools","reference":"main","file":"lectures/supportfiles/LinearRegIntegrateEx.xlsx","raw":"https://raw.githubusercontent.com/clint-bg/comptools/main/lectures/supportfiles/LinearRegIntegrateEx.xlsx"},"internal":false,"protocol":"github","key":"OG9zCuJtuC"}],"key":"AGlSTYzRpK"}],"key":"ezDH3Z0Ott"}],"key":"zjSWbi4hxH"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"24b - Optimization","url":"/lectures/b-optimization","group":"Computational Tools for Chemical Engineers"},"next":{"title":"Practice Problems","url":"/homework","group":"Computational Tools for Chemical Engineers"}}},"domain":"http://pre.render"}
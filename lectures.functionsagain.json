t"}],"key":"O63ILi0pzt"}],"key":"UbaS6Ij5e0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Method 1: Using Objects and Functions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"EXgfa0ar9C"}],"identifier":"method-1-using-objects-and-functions","label":"Method 1: Using Objects and Functions","html_id":"method-1-using-objects-and-functions","implicit":true,"key":"RTRi8Ixv1Y"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Plot the heat lost from a rod as a function of the air velocity.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aYntyqPWSO"}],"key":"Teq1Xipehx"}],"key":"kUYhL23Rwq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#first define our medium properties (or air that is impinging on the cylinder)\nimport param #import our param module\nclass medium(param.Parameterized): #set default values for air at 20C\n    k = param.Number(default=0.026, doc=\"Thermal conductivity of the medium (W/mK)\")\n    rho = param.Number(default=1.204, doc=\"Density of the medium (kg/m^3)\")\n    cp = param.Number(default=1006.0, doc=\"Specific heat of the medium (J/kgK)\")\n    mu = param.Number(default=1.82e-5, doc=\"Dynamic viscosity of the medium (kg/ms)\")\n\n    #Define function for the Reynolds number and Prandtl numbers\n    # see pages 209 and 210 in the NCESS FE Handbook\n    def Re(self, v, D):\n        return self.rho*v*D/self.mu\n    def Pr(self):\n        return self.mu*self.cp/self.k\n    def Nu_crossflowCyl(self, v, D):\n        ReN = self.Re(v,D)\n        if ReN<4:\n            C = 0.989; n = 0.330\n        elif ReN<40:\n            C = 0.911; n = 0.385\n        elif ReN<4000:\n            C = 0.683; n = 0.466\n        elif ReN<40000:\n            C = 0.193; n = 0.618\n        else:\n            C = 0.0266; n = 0.805\n        return C*ReN**n*self.Pr()**(1/3)\n# set air object\nair = medium()","key":"U3cP2ykWoy"},{"type":"outputs","id":"UHIbloNg0HWqE4g58okSD","children":[],"key":"yURUGi7E5U"}],"key":"pSlY8avrqX"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"MrgbiMJRF5"}],"key":"UDKNaxU0ED"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The above code doesn’t have any global variables other than the air object. If you don’t call the medium class, you can’t access k, rho or any of the other variables or the Re or Pr methods.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"NPJyVwYbTM"}],"key":"QmoZqtoyoh"}],"key":"LvTchQ255Z"}],"key":"hi99YpwICm"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#we'll define a function to calculate the heat transfer from a hot surface in a forced \n#convection environment.  \ndef Qconv(vel=1,Dia=1,As=0.1, T_s=300, T_inf=298): #set defaults in SI units\n    # calculate the heat transfer coefficient\n    h = air.Nu_crossflowCyl(vel,Dia)/Dia*air.k #1/m * W/m/K = W/m^2/K\n    return h*As*(T_s - T_inf) #convected heat transfer, W = W/m^2/K * m^2 * K","key":"KwjXFv4Jag"},{"type":"outputs","id":"uRGgjPu6xqN4MotyQjddl","children":[],"key":"o3R2aNOjH4"}],"key":"HuKVhHlkMN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now that we have our object and functions defined, lets plot the heat loss as a function of the air velocity assuming 20C air and a 100C surface temperature of }the 0.1m diameter and 1 foot long rod.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hlD8yyFBxB"}],"key":"qh6Cq47vDQ"}],"key":"VcBfbxmkuB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np #import numpy for array operations\nimport matplotlib.pyplot as plt #import matplotlib for plotting\n#set up a range of velocities\nvel = np.linspace(0,10,100) #m/s\n#set up the rod properties\nrodDia = 0.1 #m\nrodLength = 1/3.281 #foot to meter\nrodArea = np.pi*rodDia*rodLength #m^2\n#calculate the heat transfer for each velocity\nQ = [Qconv(each,rodDia,rodArea, 393, 293) for each in vel]\n#plot the results\nplt.plot(vel,Q)\nplt.xlabel('Air Velocity (m/s)'); plt.ylabel('Heat Transfer (W)')\nplt.show()","key":"CJwVy4HmLc"},{"type":"outputs","id":"KBiOQAz-1RsUJzIuDY79K","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2690291cd737f01aae176ffa7a9aede9","path":"/comptools/_public/2690291cd737f01aae176ffa7a9aede9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"QtmYK9OGHC"}],"key":"JkbI7xVelk"}],"key":"VNGAOfZuz6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Method 2: Not using Objects","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xehgHAEdXF"}],"identifier":"method-2-not-using-objects","label":"Method 2: Not using Objects","html_id":"method-2-not-using-objects","implicit":true,"key":"gmVbBHwN2H"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Some may say","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"CljedOGRBl"}],"key":"gf62K0ntjP"},{"type":"blockquote","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"“I don’t want to use objects. I also don’t want to use a lot of functions. I know I need one for the Nusselt number correlation so I’ll start with that first. Otherwise I’ll just type everything in.”","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zeanxXsz4E"}],"key":"aDgE2z6wfH"}],"key":"B0Hbq5oE7J"}],"key":"BsSaQBAsw2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def Nu(Re, Pr):\n    if Re<4:\n        C = 0.989; n = 0.330\n    elif Re<40:\n        C = 0.911; n = 0.385\n    elif Re<4000:\n        C = 0.683; n = 0.466\n    elif Re<40000:\n        C = 0.193; n = 0.618\n    else:\n        C = 0.0266; n = 0.805\n    return C*Re**n*Pr**(1/3)","key":"QWqYA0TssC"},{"type":"outputs","id":"sHY6QY_267BbD_WY5WodQ","children":[],"key":"dbLgqLLHvf"}],"key":"RZqSE4Dq5R"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#setup up the air properties\nair_k = 0.026 #W/mK\nair_rho = 1.204 #kg/m^3\nair_cp = 1006.0 #J/kgK\nair_mu = 1.82e-5 #kg/ms\n#setup the rod properties\nrodDia = 0.1 #m\nrodLength = 1/3.281 #foot to meter\nrodArea = np.pi*rodDia*rodLength #m^2\n#now calculate the heat transfer for each velocity\nQ = []\nvel = np.linspace(0,10,100) #m/s\nfor each in vel:\n    Re = air_rho*each*rodDia/air_mu\n    Pr = air_mu*air_cp/air_k\n    h = Nu(Re,Pr)*air_k/rodDia\n    Q.append(h*rodArea*(393-293))\n#plot the results\nplt.plot(vel,Q)\nplt.xlabel('Air Velocity (m/s)'); plt.ylabel('Heat Transfer (W)')\nplt.show()","key":"HLnO1RgMKT"},{"type":"outputs","id":"FpL4ToYthaXZadueopZX8","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"2690291cd737f01aae176ffa7a9aede9","path":"/comptools/_public/2690291cd737f01aae176ffa7a9aede9.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"SHjyuDVPwl"}],"key":"v3pQaLHD8L"}],"key":"yuTcBxdFM0"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Method 2 appears to be simpler and more straight forward. However, there are advantages for using objects and embedded functions:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QhkLmrzul5"}],"key":"cQGPfuZ0WP"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"One common mistake is to use the wrong property data when calculating the Prandtl or Reynolds numbers. For example, using the thermal conductivity of the rod instead of the air when calculating the heat transfer coefficient. Including the Reynolds number and Prandtl number in the air object ensures that the correct property data is used.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"D8oZH32grG"}],"key":"FR85gSqyci"}],"key":"EAhX4odxzl"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"If you were to do this for a more complicated problem, you would have to type in the same equations over and over again. This is where objects and functions can be very useful.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uEdDien4Xo"}],"key":"X99m5NH5s5"}],"key":"Soq0Sy0yxz"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"As the lines of code increase, it becomes more difficult to keep track of all the variables. Objects and functions make that easier and more succinct.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"NMPpMNVf8B"}],"key":"BPb1CAuDl1"}],"key":"kSURBoqGbj"},{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Professional programs are written using objects and functions. It is good practice to learn how to use them.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jTa5QIRVSh"}],"key":"VX7CXInwsT"}],"key":"CYopNkAply"}],"key":"tN2AWngfP0"}],"key":"AFF9hlcdmL"}],"key":"KXDaHyBtVv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"04b - Function and Class Basics","url":"/lectures/b-functionbasics","group":"Computational Tools for Chemical Engineers"},"next":{"title":"06 - Debugging","url":"/lectures/debug","group":"Computational Tools for Chemical Engineers"}}},"domain":"http://pre.render"}
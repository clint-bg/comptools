","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Cantera is an open-source suite of tools for problems involving chemical kinetics, thermodynamics, and transport processes.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"H6qsr9ONTm"}],"key":"CP70tTM9SO"}],"key":"sLnyU4ffUe"}],"key":"RkCgAvX71b"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"First import Cantera or install then import if needed:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FynQgvluBn"}],"key":"Hv75THHslk"}],"key":"Uz6aGS4ARd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"try: \n    import cantera as ct\nexcept:\n    !pip install cantera\n    import cantera as ct","key":"zdnaUlryfM"},{"type":"outputs","id":"Ml71nsNuW3MZUMmJ3CF8f","children":[],"key":"UHs9p71j9Q"}],"key":"ugwmSXDWrN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from matplotlib import pyplot as plt\nimport numpy as np\nimport pandas as pd","key":"xc1xQgtCc8"},{"type":"outputs","id":"z2kJSJWYXnas-BMSXYang","children":[],"key":"yYIyQ9jAaK"}],"key":"uSn3xayfLN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Thermodynamics: Water","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vghJaYI13v"}],"identifier":"thermodynamics-water","label":"Thermodynamics: Water","html_id":"thermodynamics-water","implicit":true,"key":"J8YKUs7qXi"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Lets first use the thermodynamics portion of Cantera with water. Cantera has all of the steam tables internally. For example, if you open the steam table at thermopedia for example, you’ll see that the enthalpy of saturated water at 100C is 419.06 kJ/kg. We can use Cantera to verify this.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"S9uPw3qphP"}],"key":"zvKnFim2E5"}],"key":"Yu8cP4d7PE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"w = ct.Water() #units are in SI and kmol\nwz = ct.Water() #water at 273.15 K and saturated liquid\nwz.TQ = 273.16, 0\nw.TQ = 277.15, 0 # Q is quality, 0 is saturated liquid, 1 is saturated vapor\nprint(f'The liquid enthalpy at {w.T:1.2f} is {w.h-wz.h:1.2f} J/kg relative to saturated water at 273.16')\nprint(f'The liquid entropy at {w.T} is {w.s-wz.s:1.2f} J/kg/K relative to saturated water at 273.16')","key":"xRUm8ziTYT"},{"type":"outputs","id":"L6kE-vcQis5MbTxp23KPV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The liquid enthalpy at 277.15 is 16770.34 J/kg relative to saturated water at 273.16\nThe liquid entropy at 277.15 is 60.95 J/kg/K relative to saturated water at 273.16\n"},"children":[],"key":"MtX1wEdb5N"}],"key":"hjzzbgM7MB"}],"key":"PwxcFH9XJo"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"By comparison, the steam tables yield a very similar value of 16820 J/kg and 61.12 J/kg/K for the specific enthalpy and entropy of the liquid.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ubd2NwMAfo"}],"key":"i8ZvDKXgsl"}],"key":"NHOD2lAtWT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Normal boiling point","position":{"start":{"l
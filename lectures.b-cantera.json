CQ_y","children":[],"key":"RULcx7fK21"}],"key":"Ge0z9GcOR1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#setup dataframe\ndf = pd.DataFrame({'T':degc})\n#setup up solution array\narr = ct.SolutionArray(w, len(degc))","key":"n7vgM5heIn"},{"type":"outputs","id":"QfYb-O6PU-xU5GVMKQliV","children":[],"key":"BS1w7vq9mL"}],"key":"Pxa22Cxm32"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#get relative to min temp\nw.TQ = w.min_temp, 0\nsf0 = w.entropy_mass / 1.e3\nhf0 = w.enthalpy_mass / 1.e3 \narr.TQ = degc + 273.15, 1\ndf['P'] = arr.P_sat/1e5*14.5 # Pa to bar to psi\ndf['r'] = arr.density*1000/1e6 # kg/m^3 to g/cm^3\ndf['hv'] = arr.h/1000 - hf0 # kJ/kg\n#saturated liquid data\narr.TQ = degc + 273.15, 0\ndf['Pl'] = arr.P/1e5*14.5 # Pa to bar to psi\ndf['rl'] = arr.density*1000/1e6 # kg/m^3 to g/cm^3\ndf['hl'] = arr.h/1000 - hf0 # kJ/kg","key":"n792RPq0cp"},{"type":"outputs","id":"99cp9yEB7ZmR8euSvfIFZ","children":[],"key":"ZSEO22GsnJ"}],"key":"D9uvmoy3Dl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#lets add an isotherm\ndensity = np.linspace(0.01, 1.0, 1000)*1e6/1000 # kg/m^3\narr2 = ct.SolutionArray(w, len(density))\narr2.TD = 600, density","key":"FTDPfMKRq4"},{"type":"outputs","id":"FzZ1AR2IZOBMwqr9dqO_F","children":[],"key":"jtJv4kjBy3"}],"key":"ysWWOKIzss"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.plot(df.r,df.P,label='saturated vapor')\nplt.plot(df.rl,df.Pl,label='saturated liquid')\nplt.plot(density*1000/1e6,arr2.P/1e5*14.5, label='isotherm at 600K')\nplt.xlabel('Density (g/cm$^3$)'); plt.ylabel('Pressure (psi)')\nplt.ylim([0,4000])\nplt.title('Water Vapor Dome')\nplt.legend(); plt.show()","key":"FEpeYYZLIT"},{"type":"outputs","id":"kuEqbBiSy_cs6df2fDI03","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"76a31d375413bc9f3f98ae9e810df79c","path":"/comptools/_public/76a31d375413bc9f3f98ae9e810df79c.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"u6FNPlfQ9n"}],"key":"ACLQcDzvuO"}],"key":"YKtPiz0I13"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"You could also create a similar plot for the temperature versus enthalpy.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bu2XLoBqz3"}],"key":"WHalpgTv3J"}],"key":"hnQIuHY24e"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#lets add an isobar\nenthalpy = (np.linspace(10, 3200, 1000) + hf0)*1e3 # J/kg\narr3 = ct.SolutionArray(w, len(enthalpy))\narr3.HP = enthalpy, 101325*4","key":"UtcsyiI4Er"},{"type":"outputs","id":"f5_pVVUV8BXdYkEuHhXeX","children":[],"key":"G0EssFrTrG"}],"key":"BhX7LkFjPG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.plot(df.hv,df['T'],label='saturated vapor')\nplt.plot(df.hl,df['T'],label='saturated liquid')\nplt.plot(enthalpy/1e3-hf0,arr3.T-273.15, label='isobar at 4 bar')\nplt.xlabel('Enthalpy, J/kg)'); plt.ylabel('Temperature (C)')\nplt.title('Water Vapor Dome')\nplt.legend(); plt.show()","key":"dF8nNCGYa9"},{"type":"outputs","id":"3ah-DxY1T1IvgMKWwZd5o","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"22dd1250d6e9f90ceda9e234c13e3a60","path":"/comptools/_public/22dd1250d6e9f90ceda9e234c13e3a60.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"BwAFnNnrt5"}],"key":"L7bVys9a0D"}],"key":"bm6tV0pAc6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Application Example: Pumping","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JVPAMXaLCW"}],"identifier":"application-example-pumping","label":"Application Example: Pumping","html_id":"application-example-pumping","implicit":true,"key":"iH71bKMDnk"}],"key":"NYAJQgmakw"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Typically pumping of a fluid can be assumed to increase the pressure to a given value assuming isentropic conditions (constant entropy). Typically, a pumps isentropic efficiency is 60%. As such, the enthalpyt and temperature rise through the pump can be found.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tn0qDGo9d6"}],"key":"AfSJJuBayp"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"See futher examples here: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MMV7slj2xS"},{"type":"link","url":"https://nbviewer.org/url/ignite.byu.edu/che433/lectures/lecture_07_steam/rankine_.ipynb","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"https://​nbviewer​.org​/url​/ignite​.byu​.edu​/che433​/lectures​/lecture​_07​_steam​/rankine​_​.ipynb","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vTwyYvShkG"}],"urlSource":"https://nbviewer.org/url/ignite.byu.edu/che433/lectures/lecture_07_steam/rankine_.ipynb","key":"NLXU3XDoTX"}],"key":"NOoMR5BTba"}],"key":"iP4cpMz6NJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"p_initial, p_f
rue,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Plotting with matplotlib","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"zv5oJp2yW2"}],"key":"iKn8f9qqtv"}],"key":"dj3Us5ukAV"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fitting data to a straight line (numpy.polyfit)","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"CfTvZmslXf"}],"key":"iMCP8PFYcv"}],"key":"YCdG7PLuki"}],"key":"izt13lXMWT"}],"key":"JXuvaSDphG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"nsteps = 1000; nwalks = 1000\nsqdists = np.zeros((nwalks,nsteps))\nfor i in range(nwalks):\n    #set parameters for 2-D random walk\n    x = 0; y = 0 #initial x,y coordinate\n    x_loc = [x]; y_loc = [y] #set up arrays for x and y coordinates\n    for j in range(nsteps):\n        # for each step, the x or y coordinates change by 1 or -1 depending on the random number\n        if np.random.randint(0,2) == 1:\n            x += np.random.choice([-1,1])\n        else:\n            y += np.random.choice([-1,1])\n        x_loc.append(x); y_loc.append(y)\n        sqdists[i,j] = (x**2 + y**2) #distance from origin","key":"gjgCnRzY9Q"},{"type":"outputs","id":"4rWNTyY921uv5AyeyP3FJ","children":[],"key":"hnatMwzjsK"}],"key":"n4PIuLzeyg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"plt.plot(x_loc,y_loc)\nplt.plot(x_loc[0],y_loc[0],'go')\nplt.plot(x_loc[-1],y_loc[-1],'ro')\nplt.xlabel('x position'); plt.ylabel('y position')\nplt.title('2-D Random Walk')\nplt.legend(['Random Walk','Start','End'])\nplt.show()","key":"ry8nBlg2rO"},{"type":"outputs","id":"qf0n5GhOnWhZNghPc6yN1","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"c6c9c76162c8ba3b528af70410855095","path":"/comptools/_public/c6c9c76162c8ba3b528af70410855095.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"TQlTLDV93B"}],"key":"x5iV5pFOuT"}],"key":"nBeQ7es81s"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy.optimize import leastsq\ndef slopefit(x, y):\n    '''Fits a linear fit of the form mx to the data'''\n    fitfunc = lambda slope, x: slope * x    #create fitting function of form mx\n    errfunc = lambda slope, x, y: fitfunc(slope, x) - y   #create error function for least squares fit\n\n    #calculate best fitting parameters (i.e. m) using the error function\n    slope, success = leastsq(errfunc, 1, args = (x, y))\n    return slope","key":"E5WNi7sTX2"},{"type":"outputs","id":"o_PvgV3PSl5ld7x1gHnA1","children":[],"key":"mNTGWP9J6G"}],"key":"zOqZqgIXQb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"avesqdists = np.mean(sqdists,axis=0)\nfit = slopefit(np.arange(nsteps),avesqdists)\nplt.plot(fit*(np.arange(nsteps)),'k-.',label=\"Linear fit\")\nplt.plot(avesqdists,label=\"Average squared distance, nwalks = 1000\")\nplt.plot(np.mean(sqdists[:100],axis=0),label=\"Average squared distance, nwalks = 100\")\nplt.plot(np.mean(sqdists[:10],axis=0),label=\"Average squared distance, nwalks = 10\")\nplt.legend()\nplt.xlabel(\"Number of steps\"); plt.ylabel(\"Average squared distance from origin\")\nplt.show()","key":"eZUiEHgxMP"},{"type":"outputs","id":"Ivj8G72TQ_lkVfrMtEHOZ","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"3f8d0fb7983569ce89dbb9d50f969c3c","path":"/comptools/_public/3f8d0fb7983569ce89dbb9d50f969c3c.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"t6FFRd8w5c"}],"key":"OWLUHX7cbQ"}],"key":"BHqSd44nXP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"mfp = 69e-9 #mean free path in meters\nspeed_n2 = np.sqrt(3*8.314*298/0.028) #speed of N2 in m/s\ntimeperstep = mfp/speed_n2 #time per step in seconds\nprint(f'The mean free path is {mfp*1e9:.2f} nm at 298 K. At that temperature, the speed of N2 is {speed_n2:.2f} m/s. The time per step is {timeperstep*1e12:.2f} ps.')","key":"Hl67DWEhqB"},{"type":"outputs","id":"47516vLnfNgZn-W_p4vWA","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The mean free path is 69.00 nm at 298 K. At that temperature, the speed of N2 is 515.22 m/s. The time per step is 133.92 ps.\n"},"children":[],"key":"kqNuZq1sNk"}],"key":"oegWVP1oUl"}],"key":"qZtp82Hda1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"_2dD = fit[0]*(mfp**2)/timeperstep #scale the slope by the mean free path and time per step\nDiffCoef = _2dD/4 #obtain the diffusion coefficient from the slope divided by 2*dimensions (2)\nprint(f'The estimated diffusion coefficient is {DiffCoef*1e4:.3f} cm^2/s.')","key":"LTcYsE2YcR"},{"type":"outputs","id":"k0OEMtVDHP5zL5LQScfPm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"The estimated diffusion coefficient is 0.089 cm^2/s.\n"},"children":[],"key":"vZo70EMjU1"}],"key":"VcmnOfZ8Fl"}],"key":"upAATnn9i2"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The diffusion coefficient of nitrogen in air at 298 is near 0.2 ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CFUlkKz4li"},{"type":"inlineMath","value":"\\text{cm}^2","position":{"start":{
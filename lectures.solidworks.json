{"version":3,"kind":"Article","sha256":"c92ec3841c2ed575f6eab9e616173338f3b32aa91012697de89c8bc8cad5030b","slug":"lectures.solidworks","location":"/lectures/20-SolidWorks.md","dependencies":[],"frontmatter":{"title":"20 - SolidWorks","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Clint Guymon","given":"Clint","family":"Guymon"},"name":"Clint Guymon","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Brigham Young University","given":"Brigham Young","family":"University"},"name":"Brigham Young University","id":"contributors-myst-generated-uid-1"}],"github":"https://github.com/clint-bg/comptools","numbering":{"title":{"offset":1}},"source_url":"https://github.com/clint-bg/comptools/blob/main/lectures/20-SolidWorks.md","edit_url":"https://github.com/clint-bg/comptools/edit/main/lectures/20-SolidWorks.md","exports":[{"format":"md","filename":"20-SolidWorks.md","url":"/comptools/_public/20-SolidWorks-bec960aafdb7d7248e5cde8c8fd6789b.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"SolidWorks is a 3D CAD (Computer Aided Drawing) software package that is widely used in engineering. You’ll use SolidWorks to create a 3D model of your choosing (with slight modification of a template) and then you’ll 3D print it. The homework will be checked off when you bring your 3D print to class after submitting a pdf image of your associated SolidWorks file.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mqPSDYk5DQ"}],"key":"SINBdua7Td"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"link","url":"https://youtu.be/ypymT835Gqw","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Helpful Video on YouTube","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"LvwUWoD8JS"}],"urlSource":"https://youtu.be/ypymT835Gqw","key":"jhf2hIeoRJ"},{"type":"text","value":" for getting started.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"sf2PteUMzS"}],"key":"CFRJ0y8Xfz"},{"type":"heading","depth":2,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"SolidWorks Software Access","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"fBg3GMcJdf"}],"identifier":"solidworks-software-access","label":"SolidWorks Software Access","html_id":"solidworks-software-access","implicit":true,"key":"V92Fb6TFqj"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"You’ll need to use one of the software licenses that BYU owns that is available to you on a CAEDM computer setup with SolidWorks.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"CvZOFmnH9G"}],"key":"YMjVOcMSqO"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"You can use one of the CAEDM lab computers or you can follow the instructions on the CAEDM website to access the software remotely using ‘labconnect’ for example.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"aL3JFZ8mbO"}],"key":"TbdvBoAvGS"},{"type":"heading","depth":2,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"SolidWorks Basics","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"wePKOt6T1c"}],"identifier":"solidworks-basics","label":"SolidWorks Basics","html_id":"solidworks-basics","implicit":true,"key":"QbicJGo5rG"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Watch the above video or another similar one to get familiar with the basics of using SolidWorks, particularly the sketch and extrude features as well as the shell feature.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ldaH1iY35a"}],"key":"ZjPM9T5m01"},{"type":"heading","depth":3,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Submodules","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"GG1rgzKtuY"}],"identifier":"submodules","label":"Submodules","html_id":"submodules","implicit":true,"key":"FM0DnTjs90"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":16,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Navigating the SolidWorks Interface (center mouse button)","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"q54PapqNhs"}],"key":"sy8dpik7hc"}],"key":"SBGBDW60L6"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sketching (line, rectangle, circle, arc, spline)","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"auepnJzd8J"}],"key":"fVuaBmc5BI"}],"key":"s7WiKcz2eD"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Dimensioning (smart dimension)","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"WF6De0sDB1"}],"key":"SpnJx5M4uV"}],"key":"fi5yv7Q1QL"},{"type":"listItem","spread":true,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Extruding (extrude, cut, revolve, shell)","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"MdnFkX87ya"}],"key":"XyVAEciWO8"}],"key":"Rzc3hjPA7I"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fillet and Chamfer","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"FqQcE1YdcJ"}],"key":"G8RKVrofCr"}],"key":"v1WkGPeOz8"}],"key":"S6eo0R66o3"},{"type":"heading","depth":2,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"SolidWorks Homework","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"E70742Rdv3"}],"identifier":"solidworks-homework","label":"SolidWorks Homework","html_id":"solidworks-homework","implicit":true,"key":"sncbDmAGLp"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"You will create a 3D model of your choosing using SolidWorks. You will then 3D print your model and bring it to class. You will also submit a pdf image of your SolidWorks file to Canvas. You must create the 3D model from scratch; meaning you can not print an existing model you download from the internet. You can use an existing model as a reference, but you must create your own model from scratch, meaning you use the tools in SolidWorks to draw and extrude and chamfer, etc. the piece.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"z90s2CsIVD"}],"key":"JrD4uF0Fiv"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"SolidWorks Example","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"mZMu9DAAc8"}],"identifier":"solidworks-example","label":"SolidWorks Example","html_id":"solidworks-example","implicit":true,"key":"A2omj6jeF0"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"In class I will go through an example of drawing and showing a plunger for the 25mL graduated cylinder that you can use in one of the case studies. I won’t give you the video or instructions but you could simply do the same thing for your assignment.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"Z37Ozeb9FV"}],"key":"PqiZkIBb2H"},{"type":"heading","depth":2,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"3D Printing","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"tcG1mAdAE0"}],"identifier":"id-3d-printing","label":"3D Printing","html_id":"id-3d-printing","implicit":true,"key":"fs091otyq0"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"There are 3D printing stations around campus. You’ll need to export your SolidWorks design to an stl file and then email or upload it to the 3D printing service. The 3D print can easily take longer than 2 hours to complete by the machine.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"z3M4n9E1i1"}],"key":"wn1NOEC6Bb"}],"key":"hBWlZNYAM6"}],"key":"PJR13CZKZ7"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"19 - Excel and Visual Basic for Applications (VBA)","url":"/lectures/excelvba","group":"Computational Tools for Chemical Engineers"},"next":{"title":"21 - Aspen Plus","url":"/lectures/aspen","group":"Computational Tools for Chemical Engineers"}}},"domain":"http://pre.render"}
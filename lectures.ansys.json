sition'); plt.ylabel('Temperature');plt.legend()\nplt.show()","key":"gRb274nPx9"},{"type":"outputs","id":"mxfh-bcMQi_a7hD-FS1dE","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"d72bf1580ff7538d511708893d5db808","path":"/comptools/_public/d72bf1580ff7538d511708893d5db808.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"seR9hxesSC"}],"key":"RJ6qTC2lBv"}],"identifier":"03199026","html_id":"03199026","key":"uDb0BoAOr4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Transient Scenario","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RrEKgn58u5"}],"identifier":"transient-scenario","label":"Transient Scenario","html_id":"transient-scenario","implicit":true,"key":"HgV72aU7qP"}],"identifier":"489efa00","html_id":"489efa00","key":"ZSwRxoWzpE"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"For each of the finite elements:","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q83NxjqvVT"}],"key":"tKqzJNBk1p"},{"type":"math","value":"\\frac{dT}{dt} = \\alpha\\frac{d^2T}{dx^2}","position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac><mrow><mi>d</mi><mi>T</mi></mrow><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo>=</mo><mi>α</mi><mfrac><mrow><msup><mi>d</mi><mn>2</mn></msup><mi>T</mi></mrow><mrow><mi>d</mi><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac></mrow><annotation encoding=\"application/x-tex\">\\frac{dT}{dt} = \\alpha\\frac{d^2T}{dx^2}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:2.0574em;vertical-align:-0.686em;\"></span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.3714em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"mord mathnormal\">t</span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.686em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:2.1771em;vertical-align:-0.686em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.0037em;\">α</span><span class=\"mord\"><span class=\"mopen nulldelimiter\"></span><span class=\"mfrac\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.4911em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"mord\"><span class=\"mord mathnormal\">x</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.7401em;\"><span style=\"top:-2.989em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\"><span class=\"mord mathnormal\">d</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.686em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span></span>","enumerator":"2","key":"NfjXnym9I8"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Equations for each element can be set and then solved using Euler’s method or with odeint. Both methods are shown below.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Q0jPuiy3ba"}],"key":"o2RLLdOpTr"}],"identifier":"18bb5879","html_id":"18bb5879","key":"mJC9w0wLrC"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Eulers Method","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SYbkBhS2l1"}],"identifier":"eulers-method","label":"Eulers Method","html_id":"eulers-method","implicit":true,"key":"xPGMcrHckh"}],"identifier":"221f3a40","html_id":"221f3a40","key":"vw1QUmwJ10"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Parameters\n\nL = 1.0  # Length of the rod\nT = 0.5  # Total time\nNx = 100  # Number of spatial points\nNt = 100  # Number of time steps\ndx = L / (Nx - 1)  # Spatial step size\ndt = T / Nt  # Time step size\n\n# Initial condition\ndef initial_condition(x):\n    return 400*np.ones(len(x)) #np.sin(np.pi * x)\n\n# Set up the grid\nx_values = np.linspace(0, L, Nx)\nu = initial_condition(x_values)  # Set initial temperature distribution\n\n# Applying boundary conditions\nu[0] = 500  # Set left end of the bar to 500°C\nu[-1] = 300  # Set right end of the bar to 300°C\n\n# Explicit finite difference method\nfor n in range(Nt):\n    u_new = u.copy()\n    for i in range(1, Nx - 1):\n        d2Tdx2 = 1 / (dx**2) * (u[i + 1] - 2 * u[i] + u[i - 1])\n        u_new[i] = u[i] + alpha * dt * d2Tdx2\n    u = u_new\n\n# Plotting the results\nplt.figure(figsize=(8, 6))\nplt.plot(x_values, u, label='Temperature distribution')\nplt.title('1D Heat Equation with Boundary Conditions')\nplt.xlabel('Rod Length')\nplt.ylabel('Temperature')\nplt.legend()\nplt.grid(True)\nplt.show()\n","key":"EloxzN3LWo"},{"type":"outputs","id":"eA-gAcp5YuKZasbOjrhRX","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"6700ca0c6892ead0734978f3a9e4eaeb","path":"/comptools/_public/6700ca0c6892ead0734978f3a9e4eaeb.png"},"text/plain":{"content":"<Figure size 800x600 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"Vum4LWQQyu"}],"key":"dS2uwYLg10"}],"identifier":"ca9fcf5b","html_id":"ca9fcf5b","key":"A4LmXwUOo2"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Odeint (More stable)","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NEbD4nymz0"}],"identifier":"odeint-more-stable","label":"Odeint (More stable)","html_id":"odeint-more-stable","implicit":true,"key":"uYKFWlNl3J"}],"identifier":"2a292d4b","html_id":"2a292d4b","key":"qw5VCilEhZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"totallength = 1\nsections = np.arange(0,100,1)\ndx = totallength/sections[-1]","key":"rUkNgGuifx"},{"type":"outputs","id":"FKOfLH-TDO9xLazLqXPem","children":[],"key":"HQk8TEWcun"}],"identifier":"8f1ce30a","html_id":"8f1ce30a","key":"EpOvQtwooF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#initial temps\nTemps = np.ones(len(sections))*400\nTemps[0] = 500; Temps[-1] = 300\n#time array\ntimes = np.linspace(0,5,100)","key":"fzoRKvSRrt"},{"type":"outputs","id":"cdTrw4hVNvHQiUzNq2z7_","children":[],"key":"zDNzEUM5Qu"}],"identifier":"eaa6ca0e","html_id":"eaa6ca0e","key":"sHyJP89vDc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def dTdt(T,time): #T is an array\n    dTdt = [0]\n    for each in range(1,len(sections)-1):\n        dTdt.append(alpha/dx**2*(T[each+1] - 2*T[each] + T[each-1]))\n    #dTdt.append(alpha/dx**2*(T[-2] - 2*T[-1] + T[-2])) #adiabatic end \n    dTdt.append(0) #constant temperature end\n    return dTdt","key":"qtth6ISLd0"},{"type":"outputs","id":"uDZPqyhuLYl9Vlkqh7b4C","children":[],"key":"qGuIPww1yE"}],"identifier":"28ae40b9","html_id":"28ae40b9","key":"SlvmGXwL6B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sol = odeint(dTdt,Temps,times)","key":"wX79O4YIUY"},{"type":"outputs","id":"9BzErJLiKTPshlPxKAlHD","children":[],"key":"HmWN9FGnwT"}],"identifier":"987ba9e9","html_id":"987ba9e9","key":"HyhBohR9oi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"xpos = np.arange(0,len(Temps)*dx,dx)","key":"h3iaCE9eOS"},{"type":"outputs","id":"ArLjPlfM8qk3jRP4ikO8j","children":[],"key":"AAb4tHKJzf"}],"identifier":"49b51806","html_id":"49b51806","key":"jmeDmCasWF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for i in range(len(times)):\n    if i%10 == 0:\n        plt.plot(xpos,sol[i])\n        pass\nplt.plot(xpos,sol[-1])\nplt.plot(x_values,u,'k-.',alpha=0.5,label='Euler')\nplt.ylim([295,505]);plt.legend()\nplt.show()","key":"gVYvB4eAaH"},{"type":"outputs","id":"JJS0GhTJXQFnph20zZcw1","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"b9a7fe0b1609e6a15151e06a99bb70f6","path":"/comptools/_public/b9a7fe0b1609e6a15151e06a99bb70f6.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"eedwJOi7Fx"}],"key":"zbs7LfG61y"}],"identifier":"8f9c316c","html_id":"8f9c316c","key":"qehfhE93j4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Concentration in a Tube","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"btpMfqEkoM"}],"identifier":"concentration-in-a-tube","label":"Concentration in a Tube","html_id":"concentration-in-a-tube","implicit":true,"key":"JYkwF9SQdU"}],"identifier":"dd37ae8f","html_id":"dd37ae8f","key":"bABX5oXvs2"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"What is the concentration as a function of time given a plug of gas is introduced into one end of a tube? Or in other words, if I inject methane into one end, how long do I have to wait before the entire tube has a concentration in the flammability limit? Given the ends are sealed.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"F6RQvZUhHA"}],"key":"pBO2jVbAq7"}],"identifier":"657059cc","html_id":"657059cc","key":"LTQsFDsxRq"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"totallength = 2 #meters\nfrom difflib import Differ\nsections = np.arange(0,200,1)\ndx = totallength/sections[-1]\nDifAB = 2.2E-5*3600 #m2/hr diffusion coefficient of methane into air","key":"EZDD9papAs"},{"type":"outputs","id":"zMUT3D_m_1gwjx3U4q3MR","children":[],"key":"UMMKGjyMoc"}],"identifier":"d510a90e","html_id":"d510a90e","key":"ho35ksjJEL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"#initial temps\nConc = np.zeros(len(sections))\nConc[0:20] = 1\n#time array\ntimes = np.linspace(0,20,100) #hours","key":"orD7BUKvgB"},{"type":"outputs","id":"kCeOxHbZtx-3qBb4lNBX-","children":[],"key":"VAnaWEINAW"}],"identifier":"909620ef","html_id":"909620ef","key":"D4KZ7Ug9ne"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def dCdt(C,time): #T is an array\n    dCdt = [DifAB / dx**2 * (2 * C[1] - 2 * C[0])] #left boundary\n    for each in range(1,len(sections)-1):\n        dCdt.append(DifAB/dx**2*(C[each+1] - 2*C[each] + C[each-1]))\n    dCdt.append(DifAB/dx**2*(2*C[-2] - 2*C[-1])) #right boundary\n    return dCdt","key":"P1YwZKXdDh"},{"type":"outputs","id":"70PfYPv5A8fkiT9xKNALO","children":[],"key":"qeAevoZI7d"}],"identifier":"728f4482","html_id":"728f4482","key":"L2xDusn4Yb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"solC = odeint(dCdt,Conc,times)","key":"F20iRx2GMt"},{"type":"outputs","id":"43PeloLXog3rdRXWwKqCs","children":[],"key":"IPuEczqShR"}],"identifier":"79f69d2a","html_id":"79f69d2a","key":"VmVucSk6nh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"xpos = np.arange(0,len(Conc)*dx,dx)","key":"NeoW1ItSpE"},{"type":"outputs","id":"405wRvR2-ycFfv5-jZTlv","children":[],"key":"hK3KVl1HC5"}],"identifier":"3d836013","html_id":"3d836013","key":"kz8CXpypxz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"num_curves = 10  # Adjust this to control how many lines are plotted\nlog_indices = np.unique(\n    np.concatenate([[0], np.logspace(0, np.log10(len(times) - 1), num=num_curves).astype(int)])\n)\nfor i in log_indices:\n    plt.plot(xpos, solC[i], label=f'time = {times[i]:.2f} hr')\nplt.plot(xpos,solC[-1])\nplt.grid(alpha=0.2); plt.ylabel('Fraction Gas'); plt.xlabel('Distance')\nplt.legend()\nplt.show()","key":"RykMzFNMj8"},{"type":"outputs","id":"qbCaqjv2Ggf2grV3-3qi6","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"f68ce53e584d6aeb29b9b7f4205b8cee","path":"/comptools/_public/f68ce53e584d6aeb29b9b7f4205b8cee.png"},"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"CplKVSkWO0"}],"key":"SszeYgjFpA"}],"identifier":"2a089ecf","html_id":"2a089ecf","key":"WuLlS6sQT7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"times[35]","key":"vdnAHyePWg"},{"type":"outputs","id":"Ck5tZxZpyAYvaxkaAvdTS","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":182,"metadata":{},"data":{"text/plain":{"content":"np.float64(7.070707070707071)","content_type":"text/plain"}}},"children":[],"key":"ikZER9vc3R"}],"key":"eqGuDJUlFN"}],"identifier":"ce3